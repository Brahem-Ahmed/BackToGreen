{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<!-- Review Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-comment me-2"></i>Review Information
        </h5>
    </div>
    
    <div class="col-md-6 mb-3">
        {{ form_label(form.note, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.note, {'attr': {'class': 'form-control'}}) }}
       {# Message d'erreur en rouge #}
        <div class="text-danger small mt-1">
            {{ form_errors(form.note) }}
        </div>
        <div class="form-text">Rate from 1 to 5 stars</div>
    </div>
    
    {#<div class="col-md-6 mb-3">
        {{ form_label(form.dateAvis, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateAvis, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.dateAvis) }}
    </div>#}
</div>

<!-- Comment Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-comment-dots me-2 "></i>Comment
        </h5>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.commentaire, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.commentaire, {'attr': {'class': 'form-control', 'rows': 6, 'placeholder': 'Enter your review comment here...'}}) }}
        {# Message d'erreur en rouge #}
        <div class="text-danger small mt-1">
            {{ form_errors(form.commentaire) }}
        </div>
        <div class="form-text">Share your experience and thoughts about the event</div>
    </div>
</div>
   
<!-- Associations Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-link me-2"></i>Associations
        </h5>
    </div>
    
    <div class="col-md-6 mb-3">
       {#{{ form_label(form.idUser, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.idUser, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.idUser) }}
        <div class="form-text">Select the user who wrote this review</div>#}
    </div>
    
    <div class="col-md-6 mb-3">
        {{ form_label(form.idEvenement, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.idEvenement, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.idEvenement) }}
        <div class="form-text">Select the event this review is for</div>
    </div>
</div>

<!-- Hidden Fields -->
{{ form_rest(form) }}

<!-- Action Buttons -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_avis_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ button_label|default('Save Review') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
 {% if avis|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead class="table-light">
                                    <tr>
                                        <th><i class="fas fa-hashtag me-1"></i>ID</th>
                                        <th><i class="fas fa-comment me-1"></i>Commentaire</th>
                                        <th><i class="fas fa-star me-1"></i>Note</th>
                                        <th><i class="fas fa-calendar-alt me-1"></i>Date Avis</th>
                                        <th><i class="fas fa-cogs me-1"></i>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                {% for avi in avis %}
                                    <tr>
                                        <td class="fw-bold">{{ avi.id }}</td>
                                        <td>
                                            {% if avi.commentaire|length > 50 %}
                                                {{ avi.commentaire|slice(0, 50) }}...
                                            {% else %}
                                                {{ avi.commentaire }}
                                            {% endif %}
                                        </td>
                                        <td>
                                            <span class="badge bg-warning text-dark">
                                                <i class="fas fa-star me-1"></i>{{ avi.note }}/5
                                            </span>
                                        </td>
                                        <td>
                                            <i class="fas fa-calendar me-1"></i>
                                            {{ avi.dateAvis ? avi.dateAvis|date('Y-m-d H:i:s') : 'N/A' }}
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('app_avis_show', {'id': avi.id}) }}" 
                                                   class="btn btn-outline-info btn-sm" 
                                                   title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                {#<a href="{{ path('app_avis_edit', {'id': avi.id}) }}" 
                                                   class="btn btn-outline-primary btn-sm" 
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>#}
                                                </a>
                                                <button type="button" 
                                                        class="btn btn-outline-danger btn-sm" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#deleteModal{{ avi.id }}"
                                                        title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </div>

                                            <!-- Delete Modal -->
                                            <div class="modal fade" id="deleteModal{{ avi.id }}" tabindex="-1">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Confirm Delete</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            Are you sure you want to delete this review?
                                                            {% if avi.commentaire %}
                                                                <br><strong>"{{ avi.commentaire|slice(0, 50) }}{% if avi.commentaire|length > 50 %}...{% endif %}"</strong>
                                                            {% endif %}
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form method="post" action="{{ path('app_avis_delete', {'id': avi.id}) }}" style="display: inline;">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ avi.id) }}">
                                                                <button class="btn btn-danger">Delete</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                                                            </div>
                                                            <nav aria-label="Pagination" class="mt-3">
                                                                    {{ knp_pagination_render(avis) }}
                                                            </nav>
                    {% else %}
                        <div class="text-center py-5">
                            <i class="fas fa-comments fa-4x text-muted mb-3"></i>
                            <h4 class="text-muted">No Reviews Found</h4>
                            <p class="text-muted">Start by creating your first review.</p>
                            {#<a href="{{ path('app_avis_neww') }}" class="btn btn-primary">
                                <i class="fas fa-plus me-1"></i>Create First Review
                            </a>#}
                        </div>
                    {% endif %}
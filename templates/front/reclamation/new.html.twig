{% extends 'frontoffice/layout.html.twig' %}

{% block title %}Submit a Complaint - BackToGreen{% endblock %}

{% block body %}
<div class="bg-gradient text-white py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center">
                <h1 class="display-4 fw-bold mb-3">
                    <i class="fas fa-comment-dots me-3"></i>Submit a Complaint
                </h1>
                <p class="lead mb-0">We value your feedback. Let us know about any issues or concerns.</p>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Information Card -->
            <div class="card shadow-sm mb-4 border-0">
                <div class="card-body bg-light">
                    <div class="d-flex align-items-start">
                        <i class="fas fa-info-circle text-primary fs-3 me-3 mt-1"></i>
                        <div>
                            <h5 class="mb-2">Before You Submit</h5>
                            <ul class="mb-0 small">
                                <li>Provide as much detail as possible to help us understand your issue</li>
                                <li>Choose the appropriate priority level</li>
                                <li>You can track your complaint status in "My Complaints"</li>
                                <li>We typically respond within 24-48 hours</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Form Card -->
            <div class="card shadow hover-shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-file-alt me-2"></i>Complaint Details
                    </h4>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
                    
                    <div class="mb-4">
                        {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        <span class="text-danger">*</span>
                        {{ form_widget(form.titre) }}
                        <div class="form-text">Give your complaint a clear, concise title</div>
                        {{ form_errors(form.titre) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        <span class="text-danger">*</span>
                        {{ form_widget(form.description) }}
                        <div class="form-text">Explain the issue in detail - what happened, when, where?</div>
                        {{ form_errors(form.description) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.priorite, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.priorite) }}
                        {{ form_help(form.priorite) }}
                        {{ form_errors(form.priorite) }}
                    </div>

                    <div class="alert alert-info d-flex align-items-center mb-4">
                        <i class="fas fa-shield-alt me-2"></i>
                        <small>Your personal information is kept confidential and will only be used to respond to your complaint.</small>
                    </div>

                    <div class="d-flex gap-3 justify-content-between">
                        <a href="{{ path('app_front_reclamation_list') }}" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to My Complaints
                        </a>
                        <button type="submit" class="btn btn-primary btn-lg px-5">
                            <i class="fas fa-paper-plane me-2"></i>Submit Complaint
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            <!-- Additional Help -->
            <div class="text-center mt-4">
                <p class="text-muted">
                    <i class="fas fa-question-circle me-1"></i>
                    Need immediate assistance? Contact us at 
                    <a href="mailto:support@backtogreen.com">support@backtogreen.com</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
    }
    
    .form-label.fw-bold {
        color: #333;
        margin-bottom: 0.5rem;
    }
    
    .invalid-feedback {
        display: block;
    }
</style>
{% endblock %}

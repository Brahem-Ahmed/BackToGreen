{% extends 'frontoffice/layout.html.twig' %}

{% block title %}Complaint #{{ reclamation.id }} - BackToGreen{% endblock %}

{% block body %}
<div class="bg-gradient text-white py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <a href="{{ path('app_front_reclamation_list') }}" class="btn btn-light btn-sm mb-3">
                    <i class="fas fa-arrow-left me-1"></i>Back to My Complaints
                </a>
                <h1 class="display-5 fw-bold mb-2">
                    <i class="fas fa-file-alt me-3"></i>{{ reclamation.titre }}
                </h1>
                <p class="mb-0">
                    Complaint #{{ reclamation.id }} | 
                    Submitted on {{ reclamation.dateReclamation|date('F d, Y at H:i') }}
                </p>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="row">
        <div class="col-lg-8">
            <!-- Complaint Details -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-light py-3">
                    <h4 class="mb-0">
                        <i class="fas fa-info-circle me-2 text-primary"></i>Complaint Details
                    </h4>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <h6 class="text-muted mb-2">Description</h6>
                        <p class="mb-0" style="white-space: pre-wrap;">{{ reclamation.description }}</p>
                    </div>

                    {% if reclamation.priorite %}
                        <div class="mb-3">
                            <h6 class="text-muted mb-2">Priority Level</h6>
                            {% set priorite = reclamation.priorite.value %}
                            {% if priorite == 'URGENTE' %}
                                <span class="badge bg-danger fs-6">
                                    <i class="fas fa-exclamation-triangle me-1"></i>Urgent
                                </span>
                            {% elseif priorite == 'HAUTE' %}
                                <span class="badge fs-6" style="background-color: #fd7e14;">
                                    <i class="fas fa-exclamation-circle me-1"></i>High
                                </span>
                            {% elseif priorite == 'MOYENNE' %}
                                <span class="badge bg-warning text-dark fs-6">
                                    <i class="fas fa-info-circle me-1"></i>Medium
                                </span>
                            {% else %}
                                <span class="badge bg-secondary fs-6">
                                    <i class="fas fa-minus-circle me-1"></i>Low
                                </span>
                            {% endif %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Response Section -->
            {% if reclamation.reponse and reclamation.reponse|trim != '' %}
                <div class="card shadow-sm border-success mb-4">
                    <div class="card-header bg-success text-white py-3">
                        <h4 class="mb-0">
                            <i class="fas fa-reply me-2"></i>Our Response
                        </h4>
                    </div>
                    <div class="card-body p-4">
                        <p class="mb-0" style="white-space: pre-wrap;">{{ reclamation.reponse }}</p>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info d-flex align-items-center">
                    <i class="fas fa-hourglass-half me-3 fs-4"></i>
                    <div>
                        <strong>Awaiting Response</strong>
                        <p class="mb-0 small">Our team is reviewing your complaint and will respond soon.</p>
                    </div>
                </div>
            {% endif %}
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
            <!-- Status Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-flag me-2"></i>Status
                    </h5>
                </div>
                <div class="card-body text-center p-4">
                    {% set statut = reclamation.statut.value %}
                    {% if statut == 'EN_ATTENTE' %}
                        <i class="fas fa-clock text-warning" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-2">Pending</h4>
                        <p class="text-muted small mb-0">Your complaint is in our queue and will be reviewed soon.</p>
                    {% elseif statut == 'EN_COURS' %}
                        <i class="fas fa-spinner text-primary" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-2">In Progress</h4>
                        <p class="text-muted small mb-0">We are actively working on resolving your complaint.</p>
                    {% elseif statut == 'RESOLU' %}
                        <i class="fas fa-check-circle text-success" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-2">Resolved</h4>
                        <p class="text-muted small mb-0">Your complaint has been resolved. Thank you for your feedback!</p>
                    {% else %}
                        <i class="fas fa-question-circle text-secondary" style="font-size: 3rem;"></i>
                        <h4 class="mt-3 mb-2">{{ statut }}</h4>
                    {% endif %}
                </div>
            </div>

            <!-- Timeline -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>Timeline
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex mb-3">
                        <div class="me-3">
                            <i class="fas fa-circle text-primary" style="font-size: 0.5rem;"></i>
                        </div>
                        <div>
                            <strong>Submitted</strong>
                            <p class="text-muted small mb-0">{{ reclamation.dateReclamation|date('M d, Y - H:i') }}</p>
                        </div>
                    </div>
                    
                    {% if reclamation.statut.value == 'EN_COURS' or reclamation.statut.value == 'RESOLU' %}
                        <div class="d-flex mb-3">
                            <div class="me-3">
                                <i class="fas fa-circle text-primary" style="font-size: 0.5rem;"></i>
                            </div>
                            <div>
                                <strong>Under Review</strong>
                                <p class="text-muted small mb-0">Status updated to In Progress</p>
                            </div>
                        </div>
                    {% endif %}
                    
                    {% if reclamation.statut.value == 'RESOLU' %}
                        <div class="d-flex">
                            <div class="me-3">
                                <i class="fas fa-circle text-success" style="font-size: 0.5rem;"></i>
                            </div>
                            <div>
                                <strong>Resolved</strong>
                                <p class="text-muted small mb-0">Complaint marked as resolved</p>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            <!-- Need Help -->
            <div class="card bg-light border-0 mt-4">
                <div class="card-body text-center">
                    <i class="fas fa-headset text-primary fs-2 mb-3"></i>
                    <h6>Need Further Assistance?</h6>
                    <p class="small text-muted mb-3">Contact our support team</p>
                    <a href="mailto:support@backtogreen.com" class="btn btn-sm btn-primary">
                        <i class="fas fa-envelope me-1"></i>Email Support
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'frontoffice/base.html.twig' %}

{% block title %}Événements - BacktoGreen{% endblock %}

{% block hero %}
<div class="container my-5">
    <h1 class="text-center text-success mb-5">
        <i class="bi bi-calendar-event me-3"></i>Nos Événements Écologiques
    </h1>

    <div class="row">
        {% for evenement in evenements %}
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-primary">{{ evenement.titre }}</h5>
                        <p class="card-text">{{ evenement.description|slice(0, 100) }}...</p>
                        <p class="text-muted small">
                            <i class="bi bi-calendar"></i> {{ evenement.dateDebut|date('d/m/Y') }}
                            {% if evenement.lieu %} - {{ evenement.lieu }}{% endif %}
                        </p>

                        {% if evenement.groupe %}
                            <p class="mt-auto">
                                <span class="badge bg-success">
                                    <i class="bi bi-people"></i> {{ evenement.groupe.nom }}
                                </span>
                            </p>

                            {% if app.user %}
                                <a href="{{ path('front_evenement_inscrire', {'id': evenement.id}) }}"
                                   class="btn btn-success mt-2">
                                    <i class="bi bi-check2"></i> M'inscrire à l'événement
                                </a>
                            {% else %}
                                <a href="/login" class="btn btn-outline-secondary mt-2">
                                    Connexion requise
                                </a>
                            {% endif %}
                        {% else %}
                            <p class="text-muted mt-auto">Aucun groupe associé</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5">
                <p class="text-muted">Aucun événement pour le moment.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<!-- Basic Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-info-circle me-2"></i>Basic Information
        </h5>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Enter reclamation title'}}) }}
        <div class="text-danger small mt-1">
           {{ form_errors(form.titre) }}
        </div>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Enter detailed description of the reclamation'}}) }}
        <div class="text-danger small mt-1">
        {{ form_errors(form.description) }}
        </div>
    </div>
</div>

<!-- Date & Response Section -->
<div class="row mb-4">
    <div class="col-12">
      <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-calendar-alt me-2"></i> Response
        </h5>
   </div>
    {#<div class="col-md-12 mb-3">
        {{ form_label(form.dateReclamation, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateReclamation, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.dateReclamation) }}
    </div>#}
    <div class="col-md-12 mb-3">
        {{ form_label(form.reponse, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.reponse, {'attr': {'class': 'form-control', 'placeholder': 'Enter response if applicable'}}) }}
        <div class="text-danger small mt-1">
        {{ form_errors(form.reponse) }}
        </div>
    </div>
</div>

<!-- Priority & Status Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-cogs me-2"></i>Settings
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.priorite, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.priorite, {'attr': {'class': 'form-select'}}) }}
        <div class="text-danger small mt-1">
        {{ form_errors(form.priorite) }}
        {% if form.priorite.vars.help %}
            <div class="form-text">{{ form.priorite.vars.help }}</div>
        {% endif %}
        </div>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
        <div class="text-danger small mt-1">
        {{ form_errors(form.statut) }}
        {% if form.statut.vars.help %}
            <div class="form-text">{{ form.statut.vars.help }}</div>
        {% endif %}
        </div>
    </div>
</div>

<!-- User Association Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-user me-2"></i>User Association
        </h5>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.idUser, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.idUser, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.idUser) }}
    </div>
</div>

<!-- Hidden Fields (if any) -->
{{ form_rest(form) }}

<!-- Action Buttons -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_reclamation_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ button_label|default('Save Reclamation') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}
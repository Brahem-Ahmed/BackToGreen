{% extends 'backoffice/layout.html.twig' %}

{% block title %}Group Requests{% endblock %}

{% block contenu %}
    <div class="container-fluid px-4">
        <h1 class="mt-4">Pending Group Requests</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a href="{{ path('app_backoffice') }}">Dashboard</a></li>
            <li class="breadcrumb-item active">Group Requests</li>
        </ol>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {% for message in app.flashes('warning') %}
            <div class="alert alert-warning alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-users-cog me-1"></i>
                Pending Requests ({{ pending_requests|length }})
            </div>
            <div class="card-body">
                {% if pending_requests|length > 0 %}
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Email</th>
                                <th>Event</th>
                                <th>Request Date</th>
                                <th>Available Groups</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in pending_requests %}
                                <tr>
                                    <td>{{ request.user.username }}</td>
                                    <td>{{ request.user.email }}</td>
                                    <td>
                                        <strong>{{ request.evenement.titre }}</strong><br>
                                        <small class="text-muted">{{ request.evenement.lieu }}</small>
                                    </td>
                                    <td>{{ request.createdAt|date('Y-m-d H:i') }}</td>
                                    <td>
                                        <form method="post" action="{{ path('app_groupe_request_assign', {'id': request.id}) }}" class="d-inline">
                                            <select name="groupe_id" class="form-select form-select-sm" required>
                                                <option value="">Select a group...</option>
                                                {% set eventGroupes = request.evenement.groupes|default([]) %}
                                                {% if eventGroupes|length > 0 %}
                                                    {% for groupe in eventGroupes %}
                                                        <option value="{{ groupe.id }}">
                                                            {{ groupe.nom }} 
                                                            ({{ groupe.activeMembersCount }}/{{ groupe.nombreMembres }} members)
                                                        </option>
                                                    {% endfor %}
                                                {% else %}
                                                    {# Show all groups if event has no specific groups #}
                                                    {% for groupe in all_groupes|default([]) %}
                                                        <option value="{{ groupe.id }}">
                                                            {{ groupe.nom }} 
                                                            {% if groupe.evenement %}
                                                                (Event: {{ groupe.evenement.titre }})
                                                            {% endif %}
                                                        </option>
                                                    {% endfor %}
                                                {% endif %}
                                            </select>
                                    </td>
                                    <td>
                                            <button type="submit" class="btn btn-success btn-sm me-1">
                                                <i class="fas fa-check"></i> Assign
                                            </button>
                                        </form>
                                        
                                        <form method="post" action="{{ path('app_groupe_request_reject', {'id': request.id}) }}" class="d-inline" 
                                              onsubmit="return confirm('Are you sure you want to reject this request?');">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="fas fa-times"></i> Reject
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No pending group requests at the moment.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

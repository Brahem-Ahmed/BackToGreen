{% extends 'emails/base.html.twig' %}

{% block content %}
<div style="margin: 20px 0;">
    <h2 style="color: #27ae60; margin-bottom: 20px;">
        <i class="fas fa-key"></i> Password Reset Request
    </h2>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Hi <strong>{{ user.prenom }} {{ user.nom }}</strong>,
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        We received a request to reset the password for your BackToGreen account. If you didn't make this request, you can safely ignore this email.
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        To reset your password, click the button below. This link will expire in <strong>{{ expiresIn }}</strong>.
    </p>

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ resetUrl }}" 
           style="background-color: #27ae60; color: white; padding: 12px 40px; text-decoration: none; border-radius: 5px; font-size: 16px; font-weight: bold; display: inline-block;">
            Reset Password
        </a>
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #666;">
        Or copy and paste this link in your browser:
    </p>
    <p style="font-size: 12px; line-height: 1.6; color: #27ae60; word-break: break-all;">
        {{ resetUrl }}
    </p>

    <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;">

    <p style="font-size: 12px; line-height: 1.6; color: #999;">
        <strong>Security Note:</strong> Never share your password reset link with anyone. BackToGreen support staff will never ask for your password.
    </p>

    <p style="font-size: 12px; line-height: 1.6; color: #999;">
        If you didn't request a password reset, please ignore this email or contact our support team immediately.
    </p>
</div>
{% endblock %}

{% extends 'emails/base.html.twig' %}

{% block content %}
<div style="margin: 20px 0;">
    <h2 style="color: #27ae60; margin-bottom: 20px;">
        <i class="fas fa-leaf"></i> Welcome to {{ appName }}!
    </h2>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Hi <strong>{{ user.prenom }} {{ user.nom }}</strong>,
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Thank you for registering with <strong>{{ appName }}</strong>! We're excited to have you as part of our community dedicated to environmental conservation and waste management.
    </p>

    <p style="font-size: 16px; line-height: 1.6; color: #333;">
        Your account has been successfully created and is ready to use. You can now:
    </p>

    <ul style="font-size: 16px; line-height: 1.8; color: #333; margin: 20px 0;">
        <li><strong>Browse campaigns</strong> and participate in environmental initiatives</li>
        <li><strong>Join events</strong> in your community</li>
        <li><strong>Track your impact</strong> on waste reduction</li>
        <li><strong>Connect with others</strong> who share your passion for the environment</li>
    </ul>

    <div style="text-align: center; margin: 30px 0;">
        <a href="{{ baseUrl }}" 
           style="background-color: #27ae60; color: white; padding: 12px 40px; text-decoration: none; border-radius: 5px; font-size: 16px; font-weight: bold; display: inline-block;">
            Explore BackToGreen
        </a>
    </div>

    <p style="font-size: 14px; line-height: 1.6; color: #666;">
        If you have any questions or need assistance, our support team is here to help. Just reply to this email or contact us through our website.
    </p>

    <hr style="border: none; border-top: 1px solid #ddd; margin: 30px 0;">

    <p style="font-size: 12px; line-height: 1.6; color: #999;">
        <strong>Your Account Details:</strong><br>
        Email: {{ user.email }}<br>
        Name: {{ user.prenom }} {{ user.nom }}
    </p>
</div>
{% endblock %}

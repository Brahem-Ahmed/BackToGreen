{# templates/zone_collecte/statistiques.html.twig #}
{% extends 'backoffice/layout.html.twig' %}

{% block title %}📊 Statistiques Zones de Collecte{% endblock %}

{% block contenu %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">
            <i class="fas fa-chart-bar me-2"></i>
            Dashboard Statistiques
        </h1>
        <button id="refreshStats" class="btn btn-primary">
            <i class="fas fa-sync-alt me-2"></i>Actualiser
        </button>
    </div>

    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Collecté
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ stats.global_stats.total_quantite|number_format(0, ',', ' ') }} kg
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-weight fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Total Collectes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ stats.global_stats.total_collectes }}
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-recycle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Moyenne par collecte
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ stats.global_stats.moyenne_quantite|number_format(1, ',', ' ') }} kg
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calculator fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Zones de collecte
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                {{ stats.zones_count }}
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-map-marker-alt fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="row">
        <div class="col-xl-8 col-lg-7">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">
                        Quantité collectée par type de déchet
                    </h6>
                    <div class="dropdown no-arrow">
                        <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink" 
                           data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right shadow">
                            <a class="dropdown-item" href="#" id="exportChartData">
                                <i class="fas fa-download fa-sm fa-fw mr-2 text-gray-400"></i>
                                Exporter données
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="typeChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4 col-lg-5">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Top 5 des zones</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4">
                        <canvas id="zonesChart"></canvas>
                    </div>
                    <div class="mt-4 text-center small">
                        <span class="mr-2">
                            <i class="fas fa-circle text-primary"></i> Performance
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Evolution Chart -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Évolution mensuelle</h6>
                </div>
                <div class="card-body">
                    <div class="chart-area">
                        <canvas id="evolutionChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtres Ajax -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Recherche avancée</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="searchInput" class="form-label">Rechercher une zone</label>
                    <div class="input-group">
                        <input type="text" class="form-control" id="searchInput" 
                               placeholder="Nom, adresse ou horaires...">
                        <button class="btn btn-primary" id="searchButton">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="typeFilter" class="form-label">Filtrer par type</label>
                    <select class="form-select" id="typeFilter">
                        <option value="">Tous les types</option>
                        {% for type in ['PLASTIQUE', 'VERRE', 'PAPIER', 'METAL', 'ORGANIQUE'] %}
                            <option value="{{ type }}">{{ type }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Résultats Ajax -->
    <div id="searchResults" class="mt-4">
        <!-- Les résultats seront chargés ici via Ajax -->
    </div>
</div>

<!-- Loading overlay -->
<div id="loadingOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none justify-content-center align-items-center" style="z-index: 9999;">
    <div class="text-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
        <h4 class="mt-3">Chargement des données...</h4>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Initialiser les graphiques
    initCharts();
    initSearch();
    
    // Bouton refresh
    document.getElementById('refreshStats').addEventListener('click', function() {
        refreshDashboard();
    });

    // Données PHP vers JS
    const chartData = {
        typeChart: {
            labels: {{ stats.quantite_par_type.labels|json_encode|raw }},
            data: {{ stats.quantite_par_type.quantites|json_encode|raw }},
            colors: {{ stats.quantite_par_type.couleurs|json_encode|raw }}
        },
        zonesChart: {
            labels: {{ stats.top_zones|map(zone => zone.zone_nom)|json_encode|raw }},
            data: {{ stats.top_zones|map(zone => zone.total_quantite)|json_encode|raw }}
        },
        evolutionChart: {
            labels: {{ stats.evolution_mensuelle|map(e => e.mois)|reverse|json_encode|raw }},
            data: {{ stats.evolution_mensuelle|map(e => e.total_quantite)|reverse|json_encode|raw }}
        }
    };

    function initCharts() {
        // Graphique par type (Bar)
        new Chart(document.getElementById('typeChart'), {
            type: 'bar',
            data: {
                labels: chartData.typeChart.labels,
                datasets: [{
                    label: 'Quantité (kg)',
                    data: chartData.typeChart.data,
                    backgroundColor: chartData.typeChart.colors,
                    borderColor: '#fff',
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return `${context.label}: ${context.raw} kg`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Kilogrammes (kg)'
                        }
                    }
                }
            }
        });

        // Graphique top zones (Pie)
        new Chart(document.getElementById('zonesChart'), {
            type: 'pie',
            data: {
                labels: chartData.zonesChart.labels,
                datasets: [{
                    data: chartData.zonesChart.data,
                    backgroundColor: ['#2ecc71', '#3498db', '#e74c3c', '#f39c12', '#9b59b6']
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });

        // Graphique évolution (Line)
        new Chart(document.getElementById('evolutionChart'), {
            type: 'line',
            data: {
                labels: chartData.evolutionChart.labels,
                datasets: [{
                    label: 'Quantité mensuelle',
                    data: chartData.evolutionChart.data,
                    borderColor: '#3498db',
                    backgroundColor: 'rgba(52, 152, 219, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        title: {
                            display: true,
                            text: 'Kilogrammes (kg)'
                        }
                    }
                }
            }
        });
    }

    function initSearch() {
        const searchInput = document.getElementById('searchInput');
        const searchButton = document.getElementById('searchButton');
        const typeFilter = document.getElementById('typeFilter');
        const resultsContainer = document.getElementById('searchResults');

        function performSearch() {
            const search = searchInput.value;
            const type = typeFilter.value;
            
            showLoading(true);
            
            // Construire l'URL avec les paramètres
            let url = '{{ path("app_zone_collecte_search_ajax") }}';
            const params = new URLSearchParams();
            
            if (search) params.append('search', search);
            if (type) params.append('type', type);
            
            if (params.toString()) {
                url += '?' + params.toString();
            }
            
            fetch(url)
                .then(response => response.text())
                .then(html => {
                    resultsContainer.innerHTML = html;
                    showLoading(false);
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    resultsContainer.innerHTML = `
                        <div class="alert alert-danger">
                            Erreur lors de la recherche
                        </div>
                    `;
                    showLoading(false);
                });
        }

        // Recherche au clic
        searchButton.addEventListener('click', performSearch);
        
        // Recherche avec Enter
        searchInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                performSearch();
            }
        });
        
        // Recherche quand le filtre change
        typeFilter.addEventListener('change', performSearch);
    }

    function refreshDashboard() {
        showLoading(true);
        
        fetch('{{ path("app_api_zone_stats") }}')
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Recharger la page pour voir les nouvelles données
                    location.reload();
                }
            })
            .catch(error => {
                console.error('Erreur:', error);
                showLoading(false);
            });
    }

    function showLoading(show) {
        const overlay = document.getElementById('loadingOverlay');
        overlay.classList.toggle('d-none', !show);
        overlay.classList.toggle('d-flex', show);
    }
});
</script>
{% endblock %}
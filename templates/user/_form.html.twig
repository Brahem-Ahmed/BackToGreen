{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true, 'id': 'userForm'}}) }}

<div class="alert alert-info mb-4" id="validationInfo">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Form Validation:</strong> All fields marked with <span class="text-danger">*</span> are required. 
    Please ensure all information is accurate before submitting.
</div>

<!-- Personal Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-user me-2"></i>Personal Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.nom) }}
        {{ form_errors(form.nom) }}
        <div class="invalid-feedback">Please provide a valid last name (2-255 characters, letters only).</div>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.prenom) }}
        {{ form_errors(form.prenom) }}
        <div class="invalid-feedback">Please provide a valid first name (2-255 characters, letters only).</div>
    </div>
</div>

<!-- Contact Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-address-book me-2"></i>Contact Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.email) }}
        {{ form_errors(form.email) }}
        <div class="invalid-feedback">Please provide a valid email address.</div>
        {% if form.email.vars.help %}
            <div class="form-text">{{ form.email.vars.help }}</div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.telephone) }}
        {{ form_errors(form.telephone) }}
        <div class="invalid-feedback">Please provide a valid phone number (8-20 digits).</div>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.addresse, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.addresse) }}
        {{ form_errors(form.addresse) }}
        <div class="invalid-feedback">Please provide a valid address (5-500 characters).</div>
    </div>
</div>

<!-- Security Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-lock me-2"></i>Security
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.motDePasse, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        <div class="input-group">
            {{ form_widget(form.motDePasse) }}
            <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                <i class="fas fa-eye" id="eyeIcon"></i>
            </button>
        </div>
        {{ form_errors(form.motDePasse) }}
        <div class="invalid-feedback">Password must be at least 8 characters with uppercase, lowercase, and numbers.</div>
        {% if form.motDePasse.vars.help %}
            <div class="form-text">{{ form.motDePasse.vars.help }}</div>
        {% endif %}
        <div class="password-strength mt-2" id="passwordStrength"></div>
    </div>
</div>

<!-- Role Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-user-tag me-2"></i>User Role
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.role, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.role) }}
        {{ form_errors(form.role) }}
        {% if form.role.vars.help %}
            <div class="form-text">{{ form.role.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Hidden Fields (if any) -->
{{ form_rest(form) }}

<!-- Action Buttons -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ button_label|default('Save User') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}

{# Form validation is handled by assets/js/scripts.js #}

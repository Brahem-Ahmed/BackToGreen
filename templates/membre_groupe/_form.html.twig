{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<!-- Affichage des erreurs globales du formulaire -->
{% if form.vars.errors|length > 0 %}
    <div class="alert alert-danger">
        <ul class="mb-0">
            {% for error in form.vars.errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<!-- Member Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-user me-2"></i>Member Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.idUser) }}
        {{ form_widget(form.idUser, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.idUser) }}
        {% if form.idUser.vars.help %}
            <div class="form-text">{{ form.idUser.vars.help }}</div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.idEvenement) }}
        {{ form_widget(form.idEvenement, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.idEvenement) }}
    </div>
    
    <div class="col-md-6 mb-3">
        {{ form_label(form.idGroupe) }}
        {{ form_widget(form.idGroupe, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.idGroupe) }}
    </div>
</div>

<!-- Membership Details Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-calendar-alt me-2"></i>Membership Details
        </h5>
    </div>
    
    <div class="col-md-6 mb-3">
        {{ form_label(form.statut) }}
        {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
        {{ form_errors(form.statut) }}
    </div>
</div>

<!-- Action Buttons -->
<div class="d-flex justify-content-between mt-4">
    <a href="{{ path('app_membre_groupe_index') }}" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-1"></i>Cancel
    </a>
    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save me-1"></i>{{ button_label|default('Save Member') }}
    </button>
</div>

{{ form_end(form) }}




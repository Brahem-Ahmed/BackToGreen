{% if membre_groupes|length > 0 %}
    {% for membre_groupe in membre_groupes %}
        <tr>
            <!-- Colonne User avec protection -->
            <!-- Colonne User -->
<td class="ps-4 fw-semibold">
    <i class="fas fa-user me-2 text-primary"></i>
    {% if membre_groupe.idUser %}
        {{ membre_groupe.idUser.email }}
        <br>
        <small class="text-muted">
            {{ membre_groupe.idUser.prenom }} {{ membre_groupe.idUser.nom }}
        </small>
    {% else %}
        <span class="text-danger fw-bold">Utilisateur supprimé</span>
        <br>
        <small class="text-muted">(Compte introuvable)</small>
    {% endif %}
</td>

            <!-- Colonne Group avec protection -->
           <td>
    <i class="fas fa-layer-group me-2 text-info"></i>
    {% if membre_groupe.idGroupe %}
        {{ membre_groupe.idGroupe.nom }}
        <br>
        <small class="text-muted">Max: {{ membre_groupe.idGroupe.nombreMembres }} members</small>
    {% else %}
        <span class="text-danger fw-bold">Groupe supprimé</span>
    {% endif %}
</td>

            <!-- Date d'adhésion -->
            <td>
                <i class="fas fa-calendar me-1 text-muted"></i>
                {{ membre_groupe.dateAdhesion ? membre_groupe.dateAdhesion|date('Y-m-d H:i:s') : 'N/A' }}
            </td>

            <!-- Statut -->
            <td>
                {% set status_class = 'bg-light text-dark' %}
                {% if membre_groupe.statut.name == 'MEMBRE_ACTIF' %}
                    {% set status_class = 'bg-success' %}
                {% elseif membre_groupe.statut.name == 'EN_ATTENTE' %}
                    {% set status_class = 'bg-warning text-dark' %}
                {% elseif membre_groupe.statut.name == 'MEMBRE_INACTIF' %}
                    {% set status_class = 'bg-secondary' %}
                {% elseif membre_groupe.statut.name == 'ADMINISTRATEUR' %}
                    {% set status_class = 'bg-danger' %}
                {% endif %}
                <span class="badge {{ status_class }}">
                    <i class="fas fa-circle me-1 small"></i>
                    {{ membre_groupe.statut.label() }}
                </span>
            </td>

            <!-- Actions -->
            <td class="text-center">
                <div class="btn-group" role="group">
                    <a href="{{ path('app_membre_groupe_show', {'id': membre_groupe.id}) }}"
                       class="btn btn-outline-primary btn-sm"
                       title="View Details">
                        <i class="fas fa-eye"></i>
                    </a>
                    <a href="{{ path('app_membre_groupe_edit', {'id': membre_groupe.id}) }}"
                       class="btn btn-outline-secondary btn-sm"
                       title="Edit">
                        <i class="fas fa-edit"></i>
                    </a>
                </div>
            </td>
        </tr>
    {% endfor %}
{% else %}
    <tr>
        <td colspan="5" class="text-center py-4 text-muted">
            <i class="fas fa-search fa-2x mb-3"></i><br>
            Aucun membre trouvé pour ce filtre.
        </td>
    </tr>
{% endif %}
{% extends 'backoffice/layout.html.twig' %}
{% block title %}MembreGroupe Management - BacktoGreen{% endblock %}

{% block contenu %}
<div class="container px-4 px-lg-5 my-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-primary">
                    <i class="fas fa-users me-2"></i>Group Members Management
                </h1>
                <a href="{{ path('app_membre_groupe_new') }}" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i>Add New Member
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-dark">
                        <i class="fas fa-list me-2"></i>Members List
                    </h5>
                </div>

                <div class="card-body p-0">
                    <!-- Filtre par statut AJAX -->
                    <div class="p-3 bg-white border-bottom text-end">
                        <select id="statusFilter" class="form-select w-auto d-inline-block">
                            <option value="">Tous les statuts</option>
                            <option value="MEMBRE_ACTIF">Membre Actif</option>
                            {#<option value="EN_ATTENTE">En attente</option>#}
                            <option value="MEMBRE_INACTIF">Membre Inactif</option>
                           {# <option value="ADMINISTRATEUR">Administrateur</option>#}
                        </select>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th class="ps-4">User</th>
                                    <th>Group</th>
                                    <th>Join Date</th>
                                    <th>Status</th>
                                    <th class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="membersBody">
                                {% for membre_groupe in membre_groupes %}
                                    <tr>
                                        <!-- Colonne User avec protection contre utilisateur supprimé -->
                                       <td class="ps-4 fw-semibold">
    <i class="fas fa-user me-2 text-primary"></i>
    {% if membre_groupe.idUser %}
        {{ membre_groupe.idUser.email }}
        <br>
        <small class="text-muted">
            {{ membre_groupe.idUser.prenom }} {{ membre_groupe.idUser.nom }}
        </small>
    {% else %}
        <span class="text-danger fw-bold">Utilisateur supprimé</span>
        <br>
        <small class="text-muted">(Compte introuvable)</small>
    {% endif %}
</td>
                                        <!-- Colonne Group avec protection contre groupe supprimé -->
                                        <td>
    <i class="fas fa-layer-group me-2 text-info"></i>
    {% if membre_groupe.idGroupe %}
        {{ membre_groupe.idGroupe.nom }}
        <br>
        <small class="text-muted">Max: {{ membre_groupe.idGroupe.nombreMembres }} members</small>
    {% else %}
        <span class="text-danger fw-bold">Groupe supprimé</span>
    {% endif %}
</td>
                                        <!-- Date d'adhésion -->
                                        <td>
                                            <i class="fas fa-calendar me-1 text-muted"></i>
                                            {{ membre_groupe.dateAdhesion ? membre_groupe.dateAdhesion|date('Y-m-d H:i:s') : 'N/A' }}
                                        </td>

                                        <!-- Statut -->
                                        <td>
                                            {% set status_class = '' %}
                                            {% if membre_groupe.statut.name == 'MEMBRE_ACTIF' %}
                                                {% set status_class = 'bg-success' %}
                                            {% elseif membre_groupe.statut.name == 'EN_ATTENTE' %}
                                                {% set status_class = 'bg-warning text-dark' %}
                                            {% elseif membre_groupe.statut.name == 'MEMBRE_INACTIF' %}
                                                {% set status_class = 'bg-secondary' %}
                                            {% elseif membre_groupe.statut.name == 'ADMINISTRATEUR' %}
                                                {% set status_class = 'bg-danger' %}
                                            {% else %}
                                                {% set status_class = 'bg-light text-dark' %}
                                            {% endif %}
                                            <span class="badge {{ status_class }}">
                                                <i class="fas fa-circle me-1 small"></i>
                                                {{ membre_groupe.statut.label() }}
                                            </span>
                                        </td>

                                        <!-- Actions -->
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('app_membre_groupe_show', {'id': membre_groupe.id}) }}"
                                                   class="btn btn-outline-primary btn-sm"
                                                   title="View Details">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a href="{{ path('app_membre_groupe_edit', {'id': membre_groupe.id}) }}"
                                                   class="btn btn-outline-secondary btn-sm"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4">
                                            <div class="text-muted">
                                                <i class="fas fa-inbox fa-2x mb-3"></i>
                                                <p class="mb-0">No members found</p>
                                                <small>Start by adding new members to the group</small>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.table th {
    border-top: none;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 0.5px;
}
.btn-group .btn {
    border-radius: 0.375rem;
    margin: 0 2px;
}
</style>

<!-- Script AJAX pour le filtre par statut -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script>
$(document).ready(function(){
    function loadMembers(status = '') {
        $.ajax({
            url: '{{ path('app_membre_groupe_search') }}',
            type: 'GET',
            data: { status: status },
            success: function(data) {
                $('#membersBody').html(data);
            },
            error: function(xhr, status, error) {
                console.error("Erreur AJAX:", error);
                $('#membersBody').html('<tr><td colspan="5" class="text-center text-danger py-4">Erreur de chargement des membres</td></tr>');
            }
        });
    }

    // Chargement initial (remplace les lignes statiques)
    loadMembers();

    // Filtre au changement du select
    $('#statusFilter').on('change', function() {
        loadMembers($(this).val());
    });
});
</script>

{% endblock %}
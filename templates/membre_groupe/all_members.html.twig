{% extends 'backoffice/layout.html.twig' %}

{% block title %}All Members - BacktoGreen{% endblock %}

{% block contenu %}
<div class="container px-4 px-lg-5 my-5">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-primary">
                    <i class="fas fa-users me-2"></i>All Members
                </h1>
                <a href="{{ path('app_membre_groupe_index') }}" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to Groups
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-light">
                    <h5 class="mb-0 text-dark">
                        <i class="fas fa-list me-2"></i>Complete Members List
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-primary">
                                <tr>
                                    <th>User</th>
                                    <th>Email</th>
                                    <th>Full Name</th>
                                    <th>Groups</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if users|length > 0 %}
                                    {% for user in users %}
                                        <tr>
                                            <td class="fw-semibold">
                                                <i class="fas fa-user me-2 text-primary"></i>
                                                {{ user.prenom }} {{ user.nom }}
                                            </td>
                                            <td>{{ user.email }}</td>
                                            <td>{{ user.prenom }} {{ user.nom }}</td>
                                            <td>
                                                {% if user.membreGroupes is defined and user.membreGroupes|length > 0 %}
                                                    <ul class="list-unstyled mb-0">
                                                        {% for mg in user.membreGroupes %}
                                                            <li>
                                                                <span class="badge bg-info me-1">
                                                                    {{ mg.idGroupe.nom|default('Unknown Group') }}
                                                                    ({{ mg.statut.label() }})
                                                                </span>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    <span class="text-muted">No group assigned</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <a href="{{ path('app_membre_groupe_new', {'idUser': user.id}) }}" class="btn btn-sm btn-outline-success" title="Add to group">
                                                    <i class="fas fa-plus"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-inbox fa-2x mb-3"></i>
                                            <p class="mb-0">No users found</p>
                                        </td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

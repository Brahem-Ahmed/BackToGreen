{% extends 'backoffice/layout.html.twig' %}

{% block title %}Pending Join Requests - BacktoGreen{% endblock %}

{% block contenu %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <h1 class="text-primary">
            <i class="fas fa-clock me-2"></i>Pending Join Requests
        </h1>
        <a href="{{ path('app_groupe_index') }}" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-1"></i>Back to Groups
        </a>
    </div>

    {% if pending_requests|length > 0 %}
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="fas fa-exclamation-triangle me-2"></i>{{ pending_requests|length }} Pending Request{{ pending_requests|length != 1 ? 's' : '' }}
                </h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i>User</th>
                                <th><i class="fas fa-users me-1"></i>Group</th>
                                <th><i class="fas fa-calendar-alt me-1"></i>Requested Date</th>
                                <th><i class="fas fa-envelope me-1"></i>Email</th>
                                <th class="text-center"><i class="fas fa-cogs me-1"></i>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for request in pending_requests %}
                                <tr>
                                    <td class="fw-bold">
                                        <i class="fas fa-user-circle text-primary me-2"></i>
                                        {{ request.idUser.nom }} {{ request.idUser.prenom }}
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ request.idGroupe.nom }}</span>
                                    </td>
                                    <td>
                                        <i class="fas fa-calendar-alt text-muted me-1"></i>
                                        {{ request.dateAdhesion ? request.dateAdhesion|date('Y-m-d H:i') : 'N/A' }}
                                    </td>
                                    <td>
                                        <a href="mailto:{{ request.idUser.email }}" class="text-decoration-none">
                                            {{ request.idUser.email }}
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <!-- Approve Form -->
                                            <form method="post" action="{{ path('app_membre_groupe_approve', {'id': request.id}) }}" style="display: inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ request.id) }}">
                                                <button type="submit" class="btn btn-success btn-sm" title="Approve request">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                            </form>
                                            
                                            <!-- Reject Form -->
                                            <form method="post" action="{{ path('app_membre_groupe_reject', {'id': request.id}) }}" 
                                                  style="display: inline;"
                                                  onsubmit="return confirm('Are you sure you want to reject this request?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ request.id) }}">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Reject request">
                                                    <i class="fas fa-times"></i>
                                                </button>
                                            </form>

                                            <!-- View Details -->
                                            <a href="{{ path('app_membre_groupe_show', {'id': request.id}) }}" class="btn btn-outline-info btn-sm" title="View details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    {% else %}
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="fas fa-inbox fa-4x text-muted mb-3"></i>
                <h4 class="text-muted">No Pending Requests</h4>
                <p class="text-muted mb-0">All users have been approved or there are no pending requests at this time.</p>
            </div>
        </div>
    {% endif %}

    <!-- Flash Messages -->
    {% if app.flashes %}
        <div class="mt-4">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : (type == 'success' ? 'success' : 'info') }} alert-dismissible fade show" role="alert">
                        {% if type == 'success' %}
                            <i class="fas fa-check-circle me-2"></i>
                        {% elseif type == 'error' %}
                            <i class="fas fa-exclamation-circle me-2"></i>
                        {% else %}
                            <i class="fas fa-info-circle me-2"></i>
                        {% endif %}
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    {% endif %}
</div>

<style>
    .table th {
        border-top: none;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.875rem;
        letter-spacing: 0.5px;
    }

    .btn-group .btn {
        border-radius: 0.375rem;
        margin: 0 2px;
    }

    .badge {
        font-size: 0.85rem;
        padding: 0.35rem 0.65rem;
    }
</style>
{% endblock %}

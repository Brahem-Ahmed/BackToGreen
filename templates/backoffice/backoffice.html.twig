<main>
    <div class="container-fluid px-4">
            <h1 class="mt-4">Dashboard</h1>
            <ol class="breadcrumb mb-4">
                <li class="breadcrumb-item active">BacktoGreen Admin Dashboard</li>
            </ol>
            <div class="row">
                <div class="col-xl-3 col-md-6">
                    <div class="card bg-primary text-white mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fs-4 fw-bold">{{ stats.total_events|default(0) }}</div>
                                    <div>Total Events</div>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-calendar-alt fa-2x"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex align-items-center justify-content-between">
                            <a class="small text-white stretched-link" href="{{ path('app_evenement_ecologique_index') }}">View Details</a>
                            <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card bg-success text-white mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fs-4 fw-bold">{{ stats.total_users|default(0) }}</div>
                                    <div>Users</div>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-users fa-2x"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex align-items-center justify-content-between">
                            <a class="small text-white stretched-link" href="{{ path('app_user_index') }}">View Details</a>
                            <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card bg-warning text-white mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fs-4 fw-bold">{{ stats.pending_reclamations|default(0) }}</div>
                                    <div>Pending Claims</div>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-exclamation-triangle fa-2x"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex align-items-center justify-content-between">
                            <a class="small text-white stretched-link" href="{{ path('app_reclamation_index') }}">View Details</a>
                            <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6">
                    <div class="card bg-info text-white mb-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fs-4 fw-bold">{{ stats.total_collections|default(0) }}</div>
                                    <div>Waste Collections</div>
                                </div>
                                <div class="align-self-center">
                                    <i class="fas fa-recycle fa-2x"></i>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer d-flex align-items-center justify-content-between">
                            <a class="small text-white stretched-link" href="{{ path('app_collecte_dechet_index') }}">View Details</a>
                            <div class="small text-white"><i class="fas fa-angle-right"></i></div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="row">
                <div class="col-xl-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-calendar-alt me-1"></i>
                            Recent Events
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                {% for event in recent_events|default([]) %}
                                    <a href="{{ path('app_evenement_ecologique_show', {id: event.id}) }}" class="list-group-item list-group-item-action">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">{{ event.titre }}</h6>
                                            <small>{{ event.dateDebut|date('d/m/Y') }}</small>
                                        </div>
                                        <p class="mb-1 text-muted small">{{ event.lieu }}</p>
                                    </a>
                                {% else %}
                                    <p class="text-muted">No recent events</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <i class="fas fa-exclamation-triangle me-1"></i>
                            Recent Reclamations
                        </div>
                        <div class="card-body">
                            <div class="list-group">
                                {% for reclamation in recent_reclamations|default([]) %}
                                    <a href="{{ path('app_reclamation_show', {id: reclamation.id}) }}" class="list-group-item list-group-item-action">
                                        <div class="d-flex w-100 justify-content-between">
                                            <h6 class="mb-1">{{ reclamation.titre }}</h6>
                                            <small><span class="badge bg-{{ reclamation.statut.value == 'EN_ATTENTE' ? 'warning' : (reclamation.statut.value == 'RESOLUE' ? 'success' : 'danger') }}">{{ reclamation.statut.label() }}</span></small>
                                        </div>
                                        <p class="mb-1 text-muted small">{{ reclamation.description|slice(0, 60) }}...</p>
                                    </a>
                                {% else %}
                                    <p class="text-muted">No recent reclamations</p>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mb-4">
                <div class="card-header">
                    <i class="fas fa-chart-bar me-1"></i>
                    Quick Statistics
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="border-start border-success border-4 ps-3 mb-3">
                                <div class="fs-5 fw-bold text-success">{{ stats.total_participations|default(0) }}</div>
                                <div class="text-muted">Total Participations</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border-start border-primary border-4 ps-3 mb-3">
                                <div class="fs-5 fw-bold text-primary">{{ stats.upcoming_events|default(0) }}</div>
                                <div class="text-muted">Upcoming Events</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border-start border-info border-4 ps-3 mb-3">
                                <div class="fs-5 fw-bold text-info">{{ stats.total_groups|default(0) }}</div>
                                <div class="text-muted">Active Groups</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="card mb-4" style="display:none;">
                <div class="card-header">
                    <i class="fas fa-table me-1"></i>
                    Recent Campaign Activities
                </div>
                <div class="card-body">
                    <table id="datatablesSimple">
                        <thead>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Type</th>
                                <th>Participants</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>Impact Score</th>
                            </tr>
                        </thead>
                        <tfoot>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Type</th>
                                <th>Participants</th>
                                <th>Status</th>
                                <th>Start Date</th>
                                <th>Impact Score</th>
                            </tr>
                        </tfoot>
                        <tbody>
                            <tr>
                                <td>Urban Reforestation</td>
                                <td>Tree Planting</td>
                                <td>247</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/08/15</td>
                                <td>92</td>
                            </tr>
                            <tr>
                                <td>Beach Cleanup Initiative</td>
                                <td>Cleanup</td>
                                <td>156</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/09/01</td>
                                <td>88</td>
                            </tr>
                            <tr>
                                <td>Community Garden Project</td>
                                <td>Gardening</td>
                                <td>89</td>
                                <td><span class="badge bg-warning">Planning</span></td>
                                <td>2023/10/10</td>
                                <td>65</td>
                            </tr>
                            <tr>
                                <td>Plastic-Free Awareness</td>
                                <td>Education</td>
                                <td>342</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/07/22</td>
                                <td>78</td>
                            </tr>
                            <tr>
                                <td>River Restoration</td>
                                <td>Conservation</td>
                                <td>121</td>
                                <td><span class="badge bg-info">Upcoming</span></td>
                                <td>2023/11/05</td>
                                <td>70</td>
                            </tr>
                            <tr>
                                <td>Solar Energy Initiative</td>
                                <td>Renewable Energy</td>
                                <td>67</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/08/30</td>
                                <td>85</td>
                            </tr>
                            <tr>
                                <td>Wildlife Protection</td>
                                <td>Conservation</td>
                                <td>203</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/09/15</td>
                                <td>90</td>
                            </tr>
                            <tr>
                                <td>Composting Program</td>
                                <td>Waste Management</td>
                                <td>98</td>
                                <td><span class="badge bg-secondary">Completed</span></td>
                                <td>2023/06/10</td>
                                <td>82</td>
                            </tr>
                            <tr>
                                <td>Environmental Education</td>
                                <td>Education</td>
                                <td>187</td>
                                <td><span class="badge bg-success">Active</span></td>
                                <td>2023/07/05</td>
                                <td>76</td>
                            </tr>
                            <tr>
                                <td>Green Transportation</td>
                                <td>Transportation</td>
                                <td>134</td>
                                <td><span class="badge bg-warning">Planning</span></td>
                                <td>2023/12/01</td>
                                <td>60</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
</main>

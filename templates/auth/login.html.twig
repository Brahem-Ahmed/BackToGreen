{% extends 'frontoffice/base.html.twig' %}

{% block title %}Login - BacktoGreen{% endblock %}

{% block hero %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <h3 class="mb-0">
                        <i class="fas fa-sign-in-alt me-2"></i>Login
                    </h3>
                </div>
                <div class="card-body p-4">
                    <!-- Flash Messages -->
                    {% for type, messages in app.flashes %}
                        {% for message in messages %}
                            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                                <i class="fas fa-{{ type == 'success' ? 'check-circle' : (type == 'error' ? 'exclamation-triangle' : 'info-circle') }} me-2"></i>
                                {{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}
                    {% endfor %}

                    <!-- Error Message -->
                    {% if error %}
                        <div class="alert alert-danger" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i>{{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    {% endif %}

                    <!-- Login Form -->
                    <form method="post" action="{{ path('app_login') }}">
                        <div class="mb-3">
                            <label for="email" class="form-label">
                                <i class="fas fa-envelope me-1"></i>Email Address
                            </label>
                            <input type="email" 
                                   class="form-control" 
                                   id="email" 
                                   name="_username" 
                                   value="{{ last_username }}"
                                   placeholder="your@email.com"
                                   required 
                                   autofocus>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label">
                                <i class="fas fa-lock me-1"></i>Password
                            </label>
                            <input type="password" 
                                   class="form-control" 
                                   id="password" 
                                   name="_password" 
                                   placeholder="Enter your password"
                                   required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Login
                            </button>
                        </div>

                        <div class="text-center">
                            <small class="text-muted">
                                <i class="fas fa-question-circle me-1"></i><a href="{{ path('app_forgot_password') }}" class="text-decoration-none">Forgot your password?</a>
                            </small>
                        </div>
                    </form>
                    <!-- OAuth Login -->
                    <div class="mt-4 pt-4 border-top">
                         <p class="text-center text-muted mb-3">Or login with:</p>
                            <div class="d-grid gap-2">
                                <a href="{{ path('connect_google') }}" class="btn btn-outline-danger">
                                <i class="fab fa-google me-2"></i>Login with Google
                                </a>
                            </div>
</div>
                </div>
                <div class="card-footer text-center py-3 bg-light">
                    <p class="mb-0">
                        Don't have an account? 
                        <a href="{{ path('app_register') }}" class="text-decoration-none fw-bold">
                            Register here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

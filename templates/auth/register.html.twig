{% extends "frontoffice/base.html.twig" %}

{% block title %}Register - BackToGreen{% endblock %}

{% set errors = errors|default([]) %}
{% set formData = formData|default({
    'nom': '',
    'prenom': '',
    'email': '',
    'telephone': '',
    'addresse': ''
}) %}

{% block hero %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h2 class="mb-0">Create Account</h2>
                    <p class="small mb-0">Join BackToGreen Community</p>
                </div>
                
                <div class="card-body p-4">
                    {% if errors %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <strong>Registration Failed!</strong>
                            <ul class="mb-0 mt-2">
                                {% for error in errors %}
                                    <li>{{ error }}</li>
                                {% endfor %}
                            </ul>
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    {% endif %}

                    <form method="POST" action="{{ path('app_register') }}" novalidate>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="prenom" class="form-label">First Name <span class="text-danger">*</span></label>
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        id="prenom" 
                                        name="prenom"
                                        value="{{ formData.prenom }}"
                                        placeholder="John"
                                        required
                                    >
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="nom" class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <input 
                                        type="text" 
                                        class="form-control" 
                                        id="nom" 
                                        name="nom"
                                        value="{{ formData.nom }}"
                                        placeholder="Doe"
                                        required
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input 
                                type="email" 
                                class="form-control" 
                                id="email" 
                                name="email"
                                value="{{ formData.email }}"
                                placeholder="john@example.com"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label for="telephone" class="form-label">Phone Number <span class="text-danger">*</span></label>
                            <input 
                                type="tel" 
                                class="form-control" 
                                id="telephone" 
                                name="telephone"
                                value="{{ formData.telephone }}"
                                placeholder="+1 (555) 000-0000"
                                required
                            >
                        </div>

                        <div class="mb-3">
                            <label for="addresse" class="form-label">Address <span class="text-danger">*</span></label>
                            <textarea 
                                class="form-control" 
                                id="addresse" 
                                name="addresse"
                                rows="2"
                                placeholder="123 Main Street, City, Country"
                                required
                            >{{ formData.addresse }}</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="motDePasse" class="form-label">Password <span class="text-danger">*</span></label>
                                    <input 
                                        type="password" 
                                        class="form-control" 
                                        id="motDePasse" 
                                        name="motDePasse"
                                        placeholder="••••••••"
                                        required
                                    >
                                    <small class="form-text text-muted d-block mt-2">
                                        Must contain: uppercase, lowercase, number (min 8 chars)
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label for="confirmPassword" class="form-label">Confirm Password <span class="text-danger">*</span></label>
                                    <input 
                                        type="password" 
                                        class="form-control" 
                                        id="confirmPassword" 
                                        name="confirmPassword"
                                        placeholder="••••••••"
                                        required
                                    >
                                </div>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="fas fa-user-plus me-2"></i>Register
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center mb-3">
                        <p class="text-muted">Or register with</p>
                        <a href="{{ path('connect_google') }}" class="btn btn-outline-danger w-100">
                            <i class="fab fa-google me-2"></i>Register with Google
                        </a>
                    </div>
                </div>

                <div class="card-footer text-center py-3 bg-light">
                    <p class="mb-0">
                        Already have an account? 
                        <a href="{{ path('app_login') }}" class="text-decoration-none fw-bold">
                            Login here
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

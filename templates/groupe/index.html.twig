<!DOCTYPE html>

<title>Groupe index</title>

{% block body %}
    <h1>Groupe index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>DateCreation</th>
                <th>NombreMembres</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for groupe in groupes %}
            <tr>
                <td>{{ groupe.id }}</td>
                <td>{{ groupe.nom }}</td>
                <td>{{ groupe.description }}</td>
                <td>{{ groupe.dateCreation ? groupe.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ groupe.nombreMembres }}</td>
                <td>
                    <a href="{{ path('app_groupe_show', {'id': groupe.id}) }}">show</a>
                    <a href="{{ path('app_groupe_edit', {'id': groupe.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_groupe_new') }}">Create new</a>
{% endblock %}

{% extends 'backoffice/layout.html.twig' %}

{% block title %}Edit Groupe - BacktoGreen{% endblock %}

{% block contenu %}
<div class="container px-4 px-lg-5 my-5">
    <div class="row">
        <div class="col-lg-8 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-primary">
                    <i class="fas fa-edit me-2"></i>Edit Groupe
                </h1>
                <a href="{{ path('app_groupe_index') }}" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Edit Groupe Information
                    </h5>
                </div>
                <div class="card-body">
                    {{ include('groupe/_form.html.twig', {'button_label': 'Update'}) }}
                </div>
            </div>

            <div class="card shadow-sm border-warning">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="fas fa-trash-alt me-2"></i>Delete Group
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-light border mb-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-info-circle text-warning me-3 fs-5"></i>
                            <div>
                                <h6 class="mb-1">Important Notice</h6>
                                <p class="mb-0 text-muted">This action cannot be undone. All group data will be permanently deleted.</p>
                            </div>
                        </div>
                    </div>
                    {{ include('groupe/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

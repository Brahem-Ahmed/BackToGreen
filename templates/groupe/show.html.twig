<!DOCTYPE html>

<title>Groupe</title>

{% block body %}
    <h1>Groupe</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ groupe.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ groupe.nom }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ groupe.description }}</td>
            </tr>
            <tr>
                <th>DateCreation</th>
                <td>{{ groupe.dateCreation ? groupe.dateCreation|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>NombreMembres</th>
                <td>{{ groupe.nombreMembres }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_groupe_index') }}">back to list</a>

    <a href="{{ path('app_groupe_edit', {'id': groupe.id}) }}">edit</a>

    {{ include('groupe/_delete_form.html.twig') }}
{% endblock %}

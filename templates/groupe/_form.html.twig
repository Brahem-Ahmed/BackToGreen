{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<!-- Group Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-users me-2"></i>Group Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.nom) }}
        {% if form.nom.vars.help %}
            <div class="form-text">{{ form.nom.vars.help }}</div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.nombreMembres, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.nombreMembres, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.nombreMembres) }}
        {% if form.nombreMembres.vars.help %}
            <div class="form-text">{{ form.nombreMembres.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Description Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-align-left me-2"></i>Description
        </h5>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
        {{ form_errors(form.description) }}
        {% if form.description.vars.help %}
            <div class="form-text">{{ form.description.vars.help }}</div>
        {% endif %}
    </div>
    <!-- Hashtags automatiques (IA) -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-success border-bottom pb-2 mb-3">
            <i class="fas fa-hashtag me-2"></i>Hashtags automatiques (IA)
        </h5>
        <button type="button" class="btn btn-success mb-3" id="generateHashtagsBtn">
            Générer 8 hashtags
        </button>
        <span id="hashtagsSpinner" style="display:none;" class="ms-2">
            <i class="fas fa-spinner fa-spin"></i>
        </span>

        <div id="hashtagsResult" class="mt-3">
            <!-- Les hashtags apparaîtront ici -->
        </div>
    </div>
</div>
</div>

<!-- Date Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-calendar me-2"></i>Date Information
        </h5>
    </div>
   {# <div class="col-md-6 mb-3">
        {{ form_label(form.dateCreation, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateCreation, {'attr': {'class': 'form-control'}}) }}
        {{ form_errors(form.dateCreation) }}
        {% if form.dateCreation.vars.help %}
            <div class="form-text">{{ form.dateCreation.vars.help }}</div>
        {% endif %}
    </div>#}
</div>

<!-- Group Status Overview (if editing existing group) -->
{% if form.vars.data.id %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card bg-light border-primary">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">
                    <i class="fas fa-chart-pie me-2"></i>Group Status Overview
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <!-- Active Members -->
                    <div class="col-md-4">
                        <div class="text-center">
                            <h5 class="mb-1">
                                <span class="badge bg-success">{{ form.vars.data.getActiveMembersCount() }}</span>
                            </h5>
                            <small class="text-muted">Active Members</small>
                        </div>
                    </div>
                    
                    <!-- Pending Requests -->
                    <div class="col-md-4">
                        <div class="text-center">
                            {% set pendingCount = 0 %}
                            {% for mg in form.vars.data.membreGroupes %}
                                {% if mg.statut == 'EN_ATTENTE' %}
                                    {% set pendingCount = pendingCount + 1 %}
                                {% endif %}
                            {% endfor %}
                            <h5 class="mb-1">
                                <span class="badge bg-warning text-dark">{{ pendingCount }}</span>
                            </h5>
                            <small class="text-muted">Pending Requests</small>
                        </div>
                    </div>
                    
                    <!-- Capacity -->
                    <div class="col-md-4">
                        <div class="text-center">
                            {% set isFull = form.vars.data.isFull() %}
                            <h5 class="mb-1">
                                <span class="badge {% if isFull %}bg-danger{% else %}bg-info{% endif %}">{{ form.vars.data.getActiveMembersCount() }}/{{ form.vars.data.nombreMembres }}</span>
                            </h5>
                            <small class="text-muted">Capacity</small>
                        </div>
                    </div>
                </div>

                <!-- Capacity Progress Bar -->
                <div class="mt-3">
                    {% set percent = form.vars.data.nombreMembres > 0 ? (form.vars.data.getActiveMembersCount() / form.vars.data.nombreMembres * 100) : 0 %}
                    <div class="progress" style="height: 24px;">
                        <div class="progress-bar {% if percent >= 100 %}bg-danger{% elseif percent >= 80 %}bg-warning{% else %}bg-success{% endif %}" 
                             role="progressbar" 
                             style="width: {{ percent }}%;" 
                             aria-valuenow="{{ percent }}" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                            <small class="d-flex align-items-center justify-content-center h-100 text-white fw-bold">{{ percent|round(0) }}%</small>
                        </div>
                    </div>
                </div>

                <!-- Quick Action Links -->
                <div class="mt-4 pt-3 border-top">
                    <div class="btn-group w-100" role="group">
                        <a href="{{ path('app_membre_groupe_index') }}" class="btn btn-sm btn-outline-primary" title="View all members">
                            <i class="fas fa-users me-1"></i>View Members
                        </a>
                        {% if pendingCount > 0 %}
                            <button type="button" class="btn btn-sm btn-outline-warning" data-bs-toggle="modal" data-bs-target="#pendingModal" title="View pending requests">
                                <i class="fas fa-clock me-1"></i>Pending ({{ pendingCount }})
                            </button>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Requests Modal -->
{% if pendingCount > 0 %}
<div class="modal fade" id="pendingModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Pending Join Requests</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="list-group">
                    {% for mg in form.vars.data.membreGroupes %}
                        {% if mg.statut == 'EN_ATTENTE' %}
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>{{ mg.idUser ? (mg.idUser.nom ~ ' ' ~ mg.idUser.prenom) : 'Unknown' }}</strong>
                                    <div class="small text-muted">Requested: {{ mg.dateAdhesion ? mg.dateAdhesion|date('Y-m-d H:i') : 'N/A' }}</div>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <form method="post" action="{{ path('app_membre_groupe_approve', {'id': mg.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('approve' ~ mg.id) }}">
                                        <button class="btn btn-success btn-sm">Approve</button>
                                    </form>
                                    <form method="post" action="{{ path('app_membre_groupe_reject', {'id': mg.id}) }}" style="display:inline; margin-left:4px;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('reject' ~ mg.id) }}">
                                        <button class="btn btn-danger btn-sm">Reject</button>
                                    </form>
                                </div>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endif %}

<!-- Hidden Fields (if any) -->
{{ form_rest(form) }}

<!-- Action Buttons -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_groupe_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ button_label|default('Save Group') }}
            </button>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    const btn = document.getElementById('generateHashtagsBtn');
    const spinner = document.getElementById('hashtagsSpinner');
    const resultDiv = document.getElementById('hashtagsResult');
    const nomInput = document.querySelector('input[id*="nom"]');
    const descriptionInput = document.querySelector('textarea[id*="description"]');

    btn.addEventListener('click', async function () {
        const nom = (nomInput?.value || '').trim();
        const description = (descriptionInput?.value || '').trim();
        const text = nom + ' ' + description;

        if (!text) {
            resultDiv.innerHTML = '<div class="alert alert-warning">Entrez d\'abord le nom ou la description !</div>';
            return;
        }

        spinner.style.display = 'inline';
        resultDiv.innerHTML = '';
        btn.disabled = true;

        try {
            const response = await fetch('{{ path("app_groupe_hashtags") }}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: text })
            });

            const data = await response.json();
            let html = '<div class="d-flex flex-wrap gap-2">';
            data.forEach(tag => {
                html += `<span class="badge bg-success fs-6 p-2">${tag}</span>`;
            });
            html += '</div>';
            resultDiv.innerHTML = html;
        } catch (e) {
            resultDiv.innerHTML = '<div class="alert alert-danger">Erreur de connexion</div>';
        } finally {
            spinner.style.display = 'none';
            btn.disabled = false;
        }
    });
});
</script>
{{ form_end(form) }}
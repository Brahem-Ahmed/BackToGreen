{% extends 'frontoffice/layout.html.twig' %}

{% block title %}Inscription - BackToGreen{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center py-3">
                    <h3 class="mb-0">
                        <i class="fas fa-user-plus me-2"></i>Créer un compte
                    </h3>
                </div>
                <div class="card-body p-4">
                    <p class="text-muted text-center mb-4">
                        Rejoignez BackToGreen et participez à nos événements écologiques
                    </p>

                    {{ form_start(registrationForm) }}
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_row(registrationForm.nom) }}
                            </div>
                            <div class="col-md-6 mb-3">
                                {{ form_row(registrationForm.prenom) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.email) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.telephone) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.addresse) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.plainPassword.first) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.plainPassword.second) }}
                        </div>

                        <div class="alert alert-info" role="alert">
                            <i class="fas fa-info-circle me-2"></i>
                            <small>Votre mot de passe doit contenir au moins 6 caractères.</small>
                        </div>

                        <button type="submit" class="btn btn-success w-100 py-2 mt-3">
                            <i class="fas fa-user-plus me-2"></i>S'inscrire
                        </button>

                    {{ form_end(registrationForm) }}

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="mb-0">Vous avez déjà un compte ?</p>
                        <a href="{{ path('app_login') }}" class="btn btn-outline-success mt-2">
                            <i class="fas fa-sign-in-alt me-2"></i>Se connecter
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'backoffice/layout.html.twig' %}

{% block title %}Statistiques Collecte - BackToGreen{% endblock %}

{% block contenu %}
<style>
    .stats-hero {
        background: linear-gradient(120deg,#64d37a, #2ecc71);
        color: white;
        padding: 28px;
        border-radius: 10px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
    }
    .stat-card { border-radius: 10px; }
    .chart-wrap { background: white; padding:20px; border-radius:10px; }
</style>

<div class="stats-hero mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h3 mb-1">Statistiques des collectes</h1>
            <p class="mb-0">Répartition des quantités collectées par type de déchet.</p>
        </div>
        <div>
            <a href="{{ path('app_collecte_dechet_index') }}" class="btn btn-light">Retour</a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="chart-wrap">
            <canvas id="donutChart" width="400" height="400"></canvas>
            <div class="text-center mt-3">
                <button id="downloadChart" class="btn btn-outline-secondary btn-sm">Télécharger le graphique</button>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="row g-3">
            {% for t in totals %}
                <div class="col-md-6">
                    <div class="card stat-card shadow-sm p-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="flex-grow-1">
                                <h5 class="mb-1">{{ t.label }}</h5>
                                <p class="mb-0 text-muted small">Total: <strong>{{ t.total|number_format(2, ',', ' ') }} kg</strong></p>
                            </div>
                            <div>
                                <div style="width:56px;height:56px;border-radius:8px;background:rgba(0,0,0,0.04);display:flex;align-items:center;justify-content:center;font-weight:700;color:#2ecc71">{{ loop.index }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">Aucune donnée disponible pour le moment.</div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-4">
            <div class="card p-3">
                <h6 class="mb-2">Détails</h6>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th class="text-end">Quantité (kg)</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for t in totals %}
                            <tr>
                                <td>{{ t.label }}</td>
                                <td class="text-end">{{ t.total|number_format(2, ',', ' ') }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js via CDN (no build required) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.3.0/dist/chart.umd.min.js"></script>
<script>
    (function(){
        const labels = {{ chartLabels|json_encode|raw }};
        const values = {{ chartValues|json_encode|raw }};

        const colors = [
            '#2ecc71', '#27ae60', '#f39c12', '#e74c3c', '#3498db', '#9b59b6', '#f1c40f', '#1abc9c'
        ];

        const ctx = document.getElementById('donutChart');
        if (ctx && labels.length) {
            const data = {
                labels: labels,
                datasets: [{
                    data: values,
                    backgroundColor: labels.map((_, i) => colors[i % colors.length]),
                    hoverOffset: 6,
                }]
            };

            const chart = new Chart(ctx, {
                type: 'doughnut',
                data: data,
                options: {
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: { callbacks: { label: (ctx) => `${ctx.label}: ${Number(ctx.formattedValue).toLocaleString()} kg` } }
                    },
                    cutout: '60%'
                }
            });

            // Download button
            document.getElementById('downloadChart').addEventListener('click', function(){
                const url = chart.toBase64Image('image/png', 1);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'collecte-dechet-stats.png';
                document.body.appendChild(a);
                a.click();
                a.remove();
            });
        }
    })();
</script>

{% endblock %}

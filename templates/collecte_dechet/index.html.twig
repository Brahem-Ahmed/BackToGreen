
{% extends 'backoffice/layout.html.twig' %}
{% block title %}CollecteDechet index - BacktoGreen{% endblock %}



{% block contenu %}
    <style>
        /* Light green background for backoffice index pages */
        .backoffice-index-bg {
            background: #eaf9ed; /* pale green */
            padding: 24px;
            border-radius: 8px;
        }
        .action-btns .btn {
            margin-right: 6px;
        }
    </style>

    <div class="backoffice-index-bg">
        <h1 class="mb-4">CollecteDechet</h1>

        <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DateCollecte</th>
                <th>Quantite</th>
                <th>TypeDechet</th>
                <th>Statut</th>
                <th>Zone</th>
                <th>User</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for collecte_dechet in collecte_dechets %}
            <tr>
                <td>{{ collecte_dechet.id }}</td>
                <td>{{ collecte_dechet.dateCollecte ? collecte_dechet.dateCollecte|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ collecte_dechet.quantite }}</td>
                <td>{{ collecte_dechet.typeDechet.label() }}</td>
                <td>{{ collecte_dechet.statut.label() }}</td>
                <td>{{ collecte_dechet.idZone ? collecte_dechet.idZone.nom : '' }}</td>
                <td>{{ collecte_dechet.idUser ? collecte_dechet.idUser : '' }}</td>
                <td>
                    <div class="action-btns">
                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_collecte_dechet_show', {'id': collecte_dechet.id}) }}">Voir</a>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_collecte_dechet_edit', {'id': collecte_dechet.id}) }}">Modifier</a>
                    </div>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
        <div class="mt-3">
            <a class="btn btn-success" href="{{ path('app_collecte_dechet_new') }}">Créer une nouvelle collecte</a>
        </div>
    </div>
{% endblock %}

    {% block after_content %}
        <div class="mt-3">
            <a class="btn btn-info" href="{{ path('app_collecte_dechet_stats') }}">Statistiques par type (quantité)</a>
        </div>
    {% endblock %}

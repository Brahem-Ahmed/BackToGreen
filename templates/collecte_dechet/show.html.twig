{% extends 'backoffice/layout.html.twig' %}
{% block title %}CollecteDechet  - BacktoGreen{% endblock %}

{% block contenu %}
    <h1>CollecteDechet</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ collecte_dechet.id }}</td>
            </tr>
            <tr>
                <th>DateCollecte</th>
                <td>{{ collecte_dechet.dateCollecte ? collecte_dechet.dateCollecte|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Quantite</th>
                <td>{{ collecte_dechet.quantite }}</td>
            </tr>

            </tr>
            <tr>
                <th>Zone</th>
                <td>{{ collecte_dechet.idZone ? collecte_dechet.idZone.nom : '' }}</td>
            </tr>
            <tr>
                <th>User</th>
                <td>{{ collecte_dechet.idUser ? collecte_dechet.idUser : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_collecte_dechet_index') }}">back to list</a>

    <a href="{{ path('app_collecte_dechet_edit', {'id': collecte_dechet.id}) }}">edit</a>


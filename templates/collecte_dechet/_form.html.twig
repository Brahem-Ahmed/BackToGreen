{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true, 'id': 'collecteDechetForm'}}) }}

<div class="alert alert-info mb-4" id="validationInfo">
    <i class="fas fa-info-circle me-2"></i>
    <strong>Form Validation:</strong> All fields marked with <span class="text-danger">*</span> are required. 
    Please ensure all information is accurate before submitting.
</div>

<!-- Weather Display Section -->
<div class="row mb-4">
    <div class="col-12">
        <div id="weatherContainer" class="card border-0 shadow-sm" style="display: none;">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">
                    <i class="fas fa-cloud-sun me-2"></i>Weather Forecast
                </h5>
            </div>
            <div class="card-body">
                <div id="weatherContent" class="text-center">
                    <div class="spinner-border text-info" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Fetching weather data...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Collection Details Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-calendar-check me-2"></i>Collection Details
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.dateCollecte, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.dateCollecte) }}
        {{ form_errors(form.dateCollecte) }}
        <div class="invalid-feedback">Please provide a valid date and time.</div>
        {% if form.dateCollecte.vars.help %}
            <div class="form-text">{{ form.dateCollecte.vars.help }}</div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.quantite, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.quantite) }}
        {{ form_errors(form.quantite) }}
        <div class="invalid-feedback">Please provide a valid quantity (positive number).</div>
        {% if form.quantite.vars.help %}
            <div class="form-text">{{ form.quantite.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Waste Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-trash me-2"></i>Waste Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.typeDechet, null, {'label_attr': {'class': 'form-label required'}}) }}

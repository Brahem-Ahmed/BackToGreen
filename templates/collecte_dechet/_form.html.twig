        {% if form.typeDechet.vars.help %}
            <div class="form-text">{{ form.typeDechet.vars.help }}</div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.statut, null, {'label_attr': {'class': 'form-label required'}}) }}
        <span class="text-danger">*</span>
        {{ form_widget(form.statut) }}
        {{ form_errors(form.statut) }}
        <div class="invalid-feedback">Please select a collection status.</div>
        {% if form.statut.vars.help %}
            <div class="form-text">{{ form.statut.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Related Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-link me-2"></i>Related Information
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.idZone, null, {'label_attr': {'class': 'form-label required'}}) }}

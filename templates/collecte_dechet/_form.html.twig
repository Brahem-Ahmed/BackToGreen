    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_collecte_dechet_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>

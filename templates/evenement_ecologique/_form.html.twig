{{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

<!-- Basic Information Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-info-circle me-2"></i>Basic Information
        </h5>
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
        {% if form.titre.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.titre.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div class="col-12 mb-3">
        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
        {% if form.description.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.description.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Date & Time Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-calendar-alt me-2"></i>Date & Time
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.dateDebut, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateDebut, {'attr': {'class': 'form-control'}}) }}
        {% if form.dateDebut.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.dateDebut.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.dateFin, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.dateFin, {'attr': {'class': 'form-control'}}) }}
        {% if form.dateFin.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.dateFin.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>

<!-- Location & Capacity Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-map-marker-alt me-2"></i>Location & Capacity
        </h5>
    </div>
    <div class="col-md-8 mb-3">
        {{ form_label(form.lieu, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.lieu, {'attr': {'class': 'form-control'}}) }}
        {% if form.lieu.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.lieu.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div class="col-md-4 mb-3">
        {{ form_label(form.capaciteMax, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.capaciteMax, {'attr': {'class': 'form-control'}}) }}
        {% if form.capaciteMax.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.capaciteMax.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
        {% if form.capaciteMax.vars.help %}
            <div class="form-text">{{ form.capaciteMax.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Category & Organizer Section -->
<div class="row mb-4">
    <div class="col-12">
        <h5 class="text-primary border-bottom pb-2 mb-3">
            <i class="fas fa-tags me-2"></i>Category & Organizer
        </h5>
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
        {% if form.categorie.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.categorie.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    <div class="col-md-6 mb-3">
        {{ form_label(form.idOrganisateur, null, {'label_attr': {'class': 'form-label'}}) }}
        {{ form_widget(form.idOrganisateur, {'attr': {'class': 'form-select'}}) }}
        {% if form.idOrganisateur.vars.errors|length > 0 %}
            <div class="text-danger small mt-2">
                {% for error in form.idOrganisateur.vars.errors %}
                    <div><i class="fas fa-exclamation-circle me-1"></i>{{ error.message }}</div>
                {% endfor %}
            </div>
        {% endif %}
        {% if form.idOrganisateur.vars.help %}
            <div class="form-text">{{ form.idOrganisateur.vars.help }}</div>
        {% endif %}
    </div>
</div>

<!-- Hidden Fields -->
{{ form_rest(form) }}

<!-- Action Buttons -->
<div class="row">
    <div class="col-12">
        <div class="d-flex justify-content-between align-items-center">
            <a href="{{ path('app_evenement_ecologique_index') }}" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i>Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>{{ button_label|default('Save Event') }}
            </button>
        </div>
    </div>
</div>

{{ form_end(form) }}

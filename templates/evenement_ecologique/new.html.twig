{% extends 'backoffice/layout.html.twig' %}

{% block title %}Create New Event - BacktoGreen{% endblock %}

{% block contenu %}
<div class="container px-4 px-lg-5 my-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="text-primary">
                    <i class="fas fa-calendar-plus me-2"></i>Create New Event
                </h1>
                <a href="{{ path('app_evenement_ecologique_index') }}" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Event Information
                    </h5>
                </div>
                <div class="card-body">
                    {{ include('evenement_ecologique/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% extends 'backoffice/layout.html.twig' %}

{% block title %}Edit Event - BacktoGreen{% endblock %}

{% block contenu %}
    <main>
        <div class="container-fluid px-4">
            <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
                <h1 class="text-primary">
                    <i class="fas fa-edit me-2"></i>Edit Ecological Event
                </h1>
                <a href="{{ path('app_evenement_ecologique_index') }}" class="btn btn-outline-primary">
                    <i class="fas fa-arrow-left me-1"></i>Back to List
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-info-circle me-2"></i>Event Information
                    </h5>
                </div>
                <div class="card-body">
                    {{ include('evenement_ecologique/_form.html.twig', {'button_label': 'Update'}) }}
                </div>
            </div>

            <div class="mt-4">
                {{ include('evenement_ecologique/_delete_form.html.twig') }}
            </div>
        </div>
    </main>
{% endblock %}

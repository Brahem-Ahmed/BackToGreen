{% extends 'backoffice/layout.html.twig' %}

{% block title %}Statistiques - {{ evenement_ecologique.titre }}{% endblock %}

{% block contenu %}
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mt-4 mb-4">
        <div>
            <h1 class="mt-4">
                <i class="fas fa-chart-bar me-2"></i>Statistiques de l'événement
            </h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('app_evenement_ecologique_index') }}">Événements</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_evenement_ecologique_show', {'id': evenement_ecologique.id}) }}">{{ evenement_ecologique.titre }}</a></li>
                    <li class="breadcrumb-item active">Statistiques</li>
                </ol>
            </nav>
        </div>
        <div>
            <a href="{{ path('app_evenement_ecologique_show', {'id': evenement_ecologique.id}) }}" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-2"></i>Retour
            </a>
            <a href="{{ path('app_evenement_ecologique_export', {'id': evenement_ecologique.id}) }}" class="btn btn-success">
                <i class="fas fa-file-csv me-2"></i>Exporter CSV
            </a>
        </div>
    </div>

    <!-- Event Info Card -->
    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-info-circle me-2"></i>Informations de l'événement
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Titre:</strong> {{ evenement_ecologique.titre }}</p>
                    <p><strong>Lieu:</strong> {{ evenement_ecologique.lieu }}</p>
                    <p><strong>Capacité maximale:</strong> {{ evenement_ecologique.capaciteMax }} participants</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Date début:</strong> {{ evenement_ecologique.dateDebut ? evenement_ecologique.dateDebut|date('d/m/Y H:i') : 'Non définie' }}</p>
                    <p><strong>Date fin:</strong> {{ evenement_ecologique.dateFin ? evenement_ecologique.dateFin|date('d/m/Y H:i') : 'Non définie' }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Inscriptions</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.total }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Présents</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.present }}</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Taux de Présence</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.tauxPresence }}%</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-percentage fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Taux de Remplissage</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.tauxRemplissage }}%</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-chart-pie fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Breakdown -->
    <div class="row mb-4">
        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-bar me-2"></i>Répartition par Statut
                    </h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Statut</th>
                                    <th>Nombre</th>
                                    <th>Pourcentage</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><span class="badge bg-info">Inscrit</span></td>
                                    <td>{{ stats.inscrit }}</td>
                                    <td>{{ stats.total > 0 ? ((stats.inscrit / stats.total) * 100)|round(1) : 0 }}%</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-primary">Confirmé</span></td>
                                    <td>{{ stats.confirme }}</td>
                                    <td>{{ stats.total > 0 ? ((stats.confirme / stats.total) * 100)|round(1) : 0 }}%</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-success">Présent</span></td>
                                    <td>{{ stats.present }}</td>
                                    <td>{{ stats.total > 0 ? ((stats.present / stats.total) * 100)|round(1) : 0 }}%</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-warning">Absent</span></td>
                                    <td>{{ stats.absent }}</td>
                                    <td>{{ stats.total > 0 ? ((stats.absent / stats.total) * 100)|round(1) : 0 }}%</td>
                                </tr>
                                <tr>
                                    <td><span class="badge bg-danger">Annulé</span></td>
                                    <td>{{ stats.annule }}</td>
                                    <td>{{ stats.total > 0 ? ((stats.annule / stats.total) * 100)|round(1) : 0 }}%</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-info-circle me-2"></i>Indicateurs Clés
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6 class="text-muted">Capacité Utilisée</h6>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: {{ stats.tauxRemplissage }}%">
                                {{ stats.tauxRemplissage }}%
                            </div>
                        </div>
                        <small class="text-muted">{{ stats.total - stats.annule }} / {{ evenement_ecologique.capaciteMax }} participants</small>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Taux de Présence</h6>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: {{ stats.tauxPresence }}%">
                                {{ stats.tauxPresence }}%
                            </div>
                        </div>
                        <small class="text-muted">{{ stats.present }} présents sur {{ stats.total - stats.annule }} actifs</small>
                    </div>

                    <div class="mb-3">
                        <h6 class="text-muted">Taux d'Annulation</h6>
                        {% set tauxAnnulation = stats.total > 0 ? ((stats.annule / stats.total) * 100)|round(1) : 0 %}
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: {{ tauxAnnulation }}%">
                                {{ tauxAnnulation }}%
                            </div>
                        </div>
                        <small class="text-muted">{{ stats.annule }} annulations sur {{ stats.total }} inscriptions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Participants List -->
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-list me-2"></i>Liste des Participants ({{ participations|length }})
            </h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover" id="dataTable">
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Date Inscription</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for participation in participations %}
                            {% set user = participation.idUser %}
                            {% set statut = participation.statut %}
                            <tr>
                                <td>{{ user ? user.prenom ~ ' ' ~ user.nom : 'N/A' }}</td>
                                <td>{{ user ? user.email : 'N/A' }}</td>
                                <td>{{ user ? user.telephone : 'N/A' }}</td>
                                <td>{{ participation.dateInscription ? participation.dateInscription|date('d/m/Y H:i') : 'N/A' }}</td>
                                <td>
                                    {% if statut %}
                                        <span class="badge bg-{{ statut.value }}">{{ statut.label }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">Non défini</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
.border-left-primary {
    border-left: 0.25rem solid #4e73df !important;
}

.border-left-success {
    border-left: 0.25rem solid #1cc88a !important;
}

.border-left-info {
    border-left: 0.25rem solid #36b9cc !important;
}

.border-left-warning {
    border-left: 0.25rem solid #f6c23e !important;
}
</style>
{% endblock %}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}BackToGreen{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bs-primary: #198754;
            --bs-primary-rgb: 25, 135, 84;
            --bs-success: #0d6efd;
        }
        
        .bg-primary {
            background-color: var(--bs-primary) !important;
        }
        
        .btn-primary {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }
        
        .btn-primary:hover {
            background-color: #157347;
            border-color: #146c43;
        }
        
        .text-primary {
            color: var(--bs-primary) !important;
        }
        
        .border-primary {
            border-color: var(--bs-primary) !important;
        }
        
        .navbar-brand {
            font-weight: 600;
        }

        .hover-shadow {
            transition: box-shadow 0.3s ease;
        }

        .hover-shadow:hover {
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15) !important;
        }

        .bg-gradient {
            background: linear-gradient(135deg, #2b7a0b 0%, #3d9a4e 100%);
        }

        /* Logout form button styling */
        .dropdown-item form {
            margin: 0;
        }
        
        .dropdown-item form button {
            width: 100%;
            text-align: left;
            background: none;
            border: none;
            padding: 0;
            color: inherit;
            cursor: pointer;
        }
        
        .dropdown-item form button:hover {
            background-color: var(--bs-dropdown-link-hover-bg);
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <!-- Navbar -->
    {% block navbar %}
        {% include 'frontoffice/includes/_navbar.html.twig' %}
    {% endblock navbar %}

    <!-- Main Content -->
    <main>
        {% block body %}{% endblock %}
    </main>

    <!-- Footer -->
    <footer class="py-5 bg-dark text-white mt-5">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5">
                <div class="col-lg-4 col-md-6 mb-4">
                    <h5 class="text-white">BackToGreen</h5>
                    <p>Ensemble pour un avenir plus vert. Rejoignez notre mouvement écologique.</p>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white">Navigation</h5>
                    <ul class="list-unstyled">
                        <li><a href="/" style="color: rgba(255, 255, 255, 0.7); text-decoration: none;">Accueil</a></li>
                        <li><a href="{{ path('app_front_events') }}" style="color: rgba(255, 255, 255, 0.7); text-decoration: none;">Événements</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="text-white">Contact</h5>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-envelope me-2"></i>contact@backtogreen.com</li>
                        <li><i class="fas fa-phone me-2"></i>+216 12 345 678</li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6 mb-4">
                    <h5 class="text-white">Suivez-nous</h5>
                    <div>
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook fa-2x"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter fa-2x"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram fa-2x"></i></a>
                    </div>
                </div>
            </div>
            <hr class="my-4" style="border-color: rgba(255, 255, 255, 0.1);">
            <p class="m-0 text-center">Copyright &copy; BackToGreen 2024</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>

{% extends 'frontoffice/base.html.twig' %}

{% block title %}My Profile - BacktoGreen{% endblock %}

{% block hero %}
<div class="bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <h4 class="mb-0">
                                <i class="fas fa-user-circle me-2"></i>My Profile
                            </h4>
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-light btn-sm">
                                <i class="fas fa-edit me-1"></i>Edit Profile
                            </a>
                        </div>
                    </div>
                    <div class="card-body p-4">
                        {% for message in app.flashes('success') %}
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>{{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-user me-1"></i>First Name
                                    </label>
                                    <div class="fw-bold">{{ user.prenom }}</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-user me-1"></i>Last Name
                                    </label>
                                    <div class="fw-bold">{{ user.nom }}</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-envelope me-1"></i>Email Address
                                    </label>
                                    <div class="fw-bold">{{ user.email }}</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-phone me-1"></i>Phone Number
                                    </label>
                                    <div class="fw-bold">{{ user.telephone }}</div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-map-marker-alt me-1"></i>Address
                                    </label>
                                    <div class="fw-bold">{{ user.addresse }}</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-shield-alt me-1"></i>Role
                                    </label>
                                    <div class="fw-bold">
                                        <span class="badge bg-{{ user.role.value == 'ADMIN' ? 'danger' : 'primary' }}">
                                            {{ user.role.value }}
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light">
                                    <label class="text-muted small mb-1">
                                        <i class="fas fa-calendar-alt me-1"></i>Member Since
                                    </label>
                                    <div class="fw-bold">{{ 'now'|date('F Y') }}</div>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex gap-2">
                            <a href="{{ path('app_home') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-arrow-left me-1"></i>Back to Home
                            </a>
                            <a href="{{ path('app_profile_edit') }}" class="btn btn-success">
                                <i class="fas fa-edit me-1"></i>Edit Profile
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

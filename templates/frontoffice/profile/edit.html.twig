{% extends 'frontoffice/base.html.twig' %}

{% block title %}Edit Profile - BacktoGreen{% endblock %}

{% block hero %}
<div class="bg-light py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h4 class="mb-0">
                            <i class="fas fa-user-edit me-2"></i>Edit Profile
                        </h4>
                    </div>
                    <div class="card-body p-4">
                        {% for message in app.flashes('error') %}
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>{{ message }}
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        {% endfor %}

                        {{ form_start(form) }}
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.prenom) }}
                                    {{ form_widget(form.prenom) }}
                                    {{ form_errors(form.prenom) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.nom) }}
                                    {{ form_widget(form.nom) }}
                                    {{ form_errors(form.nom) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.email) }}
                                    {{ form_widget(form.email) }}
                                    {{ form_errors(form.email) }}
                                    <small class="form-text text-muted">
                                        <i class="fas fa-info-circle me-1"></i>This will be your login email
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(form.telephone) }}
                                    {{ form_widget(form.telephone) }}
                                    {{ form_errors(form.telephone) }}
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group">
                                    {{ form_label(form.addresse) }}
                                    {{ form_widget(form.addresse) }}
                                    {{ form_errors(form.addresse) }}
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">
                                <i class="fas fa-times me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>Save Changes
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>

                <div class="card shadow-sm mt-3">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">
                            <i class="fas fa-lock me-2"></i>Security
                        </h6>
                        <p class="mb-2 small">Need to change your password?</p>
                        <a href="{{ path('app_forgot_password') }}" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-key me-1"></i>Reset Password
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

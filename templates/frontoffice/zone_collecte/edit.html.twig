{% extends 'base.html.twig' %}

{% block title %}Modifier zone - {{ zone.nom }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="h3 mb-3">Modifier la zone</h1>
    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-8">
                {{ form_row(form.nom) }}
                {{ form_row(form.adresse) }}
                {{ form_row(form.latitude) }}
                {{ form_row(form.longitude) }}
                {{ form_row(form.capacite) }}
                {{ form_row(form.horaires) }}
                {{ form_row(form.typeDechet) }}
            </div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('front_zone_show', {'id': zone.id}) }}" class="btn btn-link">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BacktoGreen - Campaign Event Organizer</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
   
    <style>
        :root {
            --bs-primary: #198754;
            --bs-primary-rgb: 25, 135, 84;
            --bs-success: #0d6efd;
        }
        
        .bg-primary {
            background-color: var(--bs-primary) !important;
        }
        
        .btn-primary {
            background-color: var(--bs-primary);
            border-color: var(--bs-primary);
        }
        
        .btn-primary:hover {
            background-color: #157347;
            border-color: #146c43;
        }
        
        .text-primary {
            color: var(--bs-primary) !important;
        }
        
        .border-primary {
            border-color: var(--bs-primary) !important;
        }
        
        .card-title {
            color: var(--bs-primary);
        }
        
        .navbar-brand {
            font-weight: 600;
        }
        
        .hero-section {
            background: linear-gradient(rgba(25, 135, 84, 0.8), rgba(25, 135, 84, 0.9)), url('https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1000&q=80');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 6rem 0;
            border-radius: 0 0 20px 20px;
        }
        
        .feature-icon {
            width: 60px;
            height: 60px;
            background-color: rgba(25, 135, 84, 0.1);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 1rem;
            color: var(--bs-primary);
            font-size: 1.5rem;
        }
        
        .campaign-card {
            transition: transform 0.3s ease;
            border: none;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        
        .campaign-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }
        
        .campaign-card .card-footer {
            background-color: white;
            border-top: 1px solid rgba(25, 135, 84, 0.1);
        }
        
        .stats-section {
            background-color: #f8f9fa;
            padding: 4rem 0;
        }
        
        .stat-number {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--bs-primary);
        }
        
        .stat-label {
            font-size: 1rem;
            color: #6c757d;
        }
        
        .cta-section {
            background-color: var(--bs-primary);
            color: white;
            padding: 5rem 0;
        }
        
        footer a {
            color: rgba(255, 255, 255, 0.7);
            text-decoration: none;
        }
        
        footer a:hover {
            color: white;
            text-decoration: underline;
        }
        
        .impact-counter {
            font-size: 3rem;
            font-weight: bold;
            color: var(--bs-primary);
        }
        
        .campaign-progress {
            height: 10px;
            border-radius: 5px;
        }
        
        .event-calendar {
            border-left: 4px solid var(--bs-primary);
            padding-left: 15px;
        }
    </style>
</head>
<body>

    <!-- Responsive navbar -->
    {% block navbar %}
        {% include 'frontoffice/includes/_navbar.html.twig' %}
    {% endblock navbar %}
    {% block body%}
    <!-- Hero Section -->
    {% block hero %}
        {% include 'frontoffice/includes/_hero.html.twig' %}
    {% endblock hero %}

    <!-- Stats Section -->
    <div class="stats-section">
        <div class="container px-4 px-lg-5">
            <div class="row gx-4 gx-lg-5 text-center">
                <div class="col-md-3 mb-5">
                    <div class="stat-number" id="campaignCounter">{{ activeCampaigns|default(0) }}</div>
                    <div class="stat-label">Active Campaigns</div>
                </div>
                <div class="col-md-3 mb-5">
                    <div class="stat-number" id="volunteerCounter">{{ volunteers|default(0) }}</div>
                    <div class="stat-label">Volunteers</div>
                </div>
                <div class="col-md-3 mb-5">
                    <div class="stat-number" id="eventCounter">{{ eventsOrganized|default(0) }}</div>
                    <div class="stat-label">Events Organized</div>
                </div>
                <div class="col-md-3 mb-5">
                    <div class="stat-number" id="countryCounter">{{ countries|default(1) }}</div>
                    <div class="stat-label">Countries</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features Section -->
    <div class="container px-4 px-lg-5 my-5">
        <div class="row gx-4 gx-lg-5">
            <div class="col-12 text-center mb-5">
                <h2>How BacktoGreen Works</h2>
                <p class="lead">Our platform makes it easy to create and manage environmental initiatives</p>
            </div>
            <div class="col-lg-4 mb-5">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-calendar-alt"></i>
                </div>
                <h3 class="text-center">Event Management</h3>
                <p class="text-center">Easily create and manage environmental events, from tree planting to beach cleanups. Our tools help you coordinate volunteers, track attendance, and measure impact.</p>
            </div>
            <div class="col-lg-4 mb-5">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-users"></i>
                </div>
                <h3 class="text-center">Community Building</h3>
                <p class="text-center">Connect with like-minded individuals and organizations. Grow your movement by engaging volunteers, sharing resources, and collaborating on initiatives.</p>
            </div>
            <div class="col-lg-4 mb-5">
                <div class="feature-icon mx-auto">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3 class="text-center">Impact Tracking</h3>
                <p class="text-center">Measure and showcase your environmental impact with our tracking tools. Document carbon reductions, waste diverted, trees planted, and more.</p>
            </div>
        </div>
    </div>
    
    <!-- Call to Action -->
    <div class="card text-white bg-secondary my-5 py-4 text-center">
        <div class="card-body">
            <p class="text-white m-0">"The Earth is what we all have in common." — Wendell Berry. Join our community today and be part of the solution!</p>
        </div>
    </div>
    
    <!-- Featured Collection Zones -->
    <div class="container px-4 px-lg-5" id="campaigns">
        <div class="row gx-4 gx-lg-5">
            <div class="col-12">
                <h2 class="my-5">Featured Collection Zones</h2>
            </div>
            {% if featuredZones is defined and featuredZones|length > 0 %}
                {% for zone in featuredZones %}
                <div class="col-md-4 mb-5">
                    <div class="card h-100 campaign-card">
                        <img class="card-img-top" src="https://images.unsplash.com/photo-1532996122724-e3c354a0b15b?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80" alt="{{ zone.nom }}" />
                        <div class="card-body">
                            <h3 class="card-title">{{ zone.nom }}</h3>
                            <p class="card-text">
                                <i class="fas fa-map-marker-alt me-2"></i>{{ zone.adresse }}
                            </p>
                            <div class="mb-3">
                                <span class="badge bg-primary">{{ zone.typeDechet.label }}</span>
                                <span class="badge bg-info ms-1">Capacity: {{ zone.capacite }}</span>
                            </div>
                            <p class="card-text">
                                <i class="fas fa-clock me-2"></i><strong>Hours:</strong> {{ zone.horaires }}
                            </p>
                        </div>
                        <div class="card-footer">
                            <a class="btn btn-primary btn-sm" href="{{ path('front_zone_show', {'id': zone.id}) }}">View Details</a>
                            <a class="btn btn-outline-primary btn-sm ms-1" href="{{ path('front_zone_qr_code', {'id': zone.id}) }}">QR Code</a>
                        </div>
                    </div>
                </div>
                {% endfor %}
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle me-2"></i>No collection zones available at the moment.
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Impact Section -->
    <div class="container px-4 px-lg-5 my-5" id="impact">
        <div class="row gx-4 gx-lg-5 align-items-center">
            <div class="col-lg-6">
                <h2>Our Environmental Impact</h2>
                <p class="lead">Together with our community, we've achieved remarkable results in protecting our planet.</p>
                <div class="row mt-5">
                    <div class="col-6 mb-4">
                        <div class="impact-counter" id="treesCounter">0</div>
                        <div class="stat-label">Trees Planted</div>
                    </div>
                    <div class="col-6 mb-4">
                        <div class="impact-counter" id="plasticCounter">0</div>
                        <div class="stat-label">Plastic Waste Collected (kg)</div>
                    </div>
                    <div class="col-6 mb-4">
                        <div class="impact-counter" id="carbonCounter">0</div>
                        <div class="stat-label">Carbon Offset (tons)</div>
                    </div>
                    <div class="col-6 mb-4">
                        <div class="impact-counter" id="waterCounter">0</div>
                        <div class="stat-label">Water Bodies Cleaned</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1569163139394-de44cb2c8cb7?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=500&q=80" class="img-fluid rounded" alt="Environmental Impact">
            </div>
        </div>
    </div>
    
    <!-- Events Section -->
    {% block events_section %}
    {% endblock events_section %}
    
    <!-- CTA Section -->
    <div class="cta-section">
        <div class="container px-4 px-lg-5 text-center">
            <h2 class="mb-4">Ready to make a difference?</h2>
            <p class="mb-4">Join thousands of environmental activists and start creating change today.</p>
            <a class="btn btn-light btn-lg" href="{{ path('app_register') }}">Get Started</a>
            <a class="btn btn-outline-light btn-lg ms-2" href="{{ path('app_front_events') }}">Browse Events</a>
        </div>
    </div>
    {% endblock body %}
    <!-- Footer -->
    <footer class="py-5 bg-dark">
        <div class="container px-4 px-lg-5">
            <div class="row">
                <div class="col-lg-6 mb-4">
                    <h5 class="text-white">BacktoGreen</h5>
                    <p class="text-muted">Empowering environmental activism through technology and community.</p>
                    <div class="mt-3">
                        <a href="#" class="text-white me-3"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-linkedin-in"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Home</a></li>
                        <li><a href="#campaigns">Campaigns</a></li>
                        <li><a href="#events">Events</a></li>
                        <li><a href="#about">About</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white">Resources</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Toolkit</a></li>
                        <li><a href="#">Partners</a></li>
                        <li><a href="#">Support</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4">
                    <h5 class="text-white">Legal</h5>
                    <ul class="list-unstyled">
                        <li><a href="#">Privacy Policy</a></li>
                        <li><a href="#">Terms of Use</a></li>
                        <li><a href="#">Cookie Policy</a></li>
                    </ul>
                </div>
            </div>
            <p class="m-0 text-center text-white">Copyright &copy; BacktoGreen 2023</p>
        </div>
    </footer>
    
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Custom JavaScript -->
    <script>
        // Counter animation for statistics
        function animateCounter(elementId, finalValue, duration) {
            let element = document.getElementById(elementId);
            let startValue = 0;
            let increment = finalValue / (duration / 10);
            let currentValue = startValue;
            
            let timer = setInterval(function() {
                currentValue += increment;
                if (currentValue >= finalValue) {
                    clearInterval(timer);
                    currentValue = finalValue;
                }
    
            }, 10);
        }
        
        // Initialize counters when page loads
        window.addEventListener('DOMContentLoaded', (event) => {
            // Stats counters
            animateCounter('campaignCounter', 250, 1000);
            animateCounter('volunteerCounter', 15000, 1000);
            animateCounter('eventCounter', 500, 1000);
            animateCounter('countryCounter', 42, 1000);
            
            // Impact counters
            animateCounter('treesCounter', 12500, 1500);
            animateCounter('plasticCounter', 8500, 1500);
            animateCounter('carbonCounter', 3200, 1500);
            animateCounter('waterCounter', 150, 1500);
            
            // Smooth scrolling for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('href');
                    if (targetId === '#') return;
                    
                    const targetElement = document.querySelector(targetId);
                    if (targetElement) {
                        window.scrollTo({
                            top: targetElement.offsetTop - 70,
                            behavior: 'smooth'
                        });
                    }
                });
            });
            
            // Add animation to campaign cards on scroll
            const observerOptions = {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            };
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '1';
                        entry.target.style.transform = 'translateY(0)';
                    }
                });
            }, observerOptions);
            
            document.querySelectorAll('.campaign-card').forEach(card => {
                card.style.opacity = '0';
                card.style.transform = 'translateY(20px)';
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                observer.observe(card);
            });
        });
    </script>
</body>
</html>
{# Partial navbar used by base.html.twig - edit this file to change the site navbar #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container px-5">
        <a class="navbar-brand" href="{{ path('app_home') }}">
            <i class="fas fa-leaf me-2"></i>BacktoGreen
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="{{ path('app_front_events') }}">Events</a></li>
                {% if app.user %}
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_profile') }}">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('app_front_reclamation_list') }}">
                        <i class="fas fa-comment-dots me-1"></i>My Complaints
                    </a></li>
                {% else %}
                    <li class="nav-item"><a class="nav-link" href="#campaigns">Campaigns</a></li>
                    <li class="nav-item"><a class="nav-link" href="#impact">Our Impact</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about">About</a></li>
                {% endif %}
            </ul>
            
            {% if app.user %}
                <!-- Logged In User -->
                <div class="d-flex align-items-center ms-3">
                    <div class="dropdown">
                        <button class="btn btn-outline-light btn-sm dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-2"></i>{{ app.user.prenom }} {{ app.user.nom }}
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><h6 class="dropdown-header">{{ app.user.email }}</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_profile') }}"><i class="fas fa-user me-2"></i>My Profile</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_front_reclamation_new') }}"><i class="fas fa-exclamation-circle me-2"></i>Submit Complaint</a></li>
                            {% if app.user.role.value == 'ADMIN' %}
                                <li><a class="dropdown-item" href="{{ path('app_backoffice') }}"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form method="post" action="{{ path('app_logout') }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                                    <button type="submit" class="dropdown-item">
                                        <i class="fas fa-sign-out-alt me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            {% else %}
                <!-- Not Logged In -->
                <div class="d-flex gap-2 ms-3">
                    <a href="{{ path('app_login') }}" class="btn btn-outline-light btn-sm">
                        <i class="fas fa-sign-in-alt me-1"></i>Login
                    </a>
                    <a href="{{ path('app_register') }}" class="btn btn-success btn-sm">
                        <i class="fas fa-user-plus me-1"></i>Join Us
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</nav>
